// heirloomapp.io on Cloudflare Workers static assets (moved from GitHub
// Pages, Nov 2026). Since 2026-11-24 the site is site/'s Astro build: the
// rebuilt pages, plus every page of the repository root not rebuilt yet,
// carried over unchanged (site/scripts/legacy.mjs).
// Deploy from a clean checkout of main: `npm run deploy` (builds site/, then
// `wrangler deploy`). A generated page under the root still goes live this
// way; one Astro rebuilt (site/src/pages) is shadowed by the Astro page.
{
  "$schema": "https://unpkg.com/wrangler@4.152.0/config-schema.json",
  "name": "heirloom-site",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "heirloomapp.io", "custom_domain": true },
    { "pattern": "www.heirloomapp.io", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    // www is answered by worker.js before any file.
    "run_worker_first": true,
    "directory": "./site/dist",
    // /guides serves guides.html, /marks/ serves marks/index.html, as Pages did.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
