---
// /marks/: the reference's home. One search over the marks (src/islands/
// Portal.tsx), then the way in for someone holding an item: what do you see
// on it? Each answer is an area of the reference (lib/reference.ts). Then how
// to tell Chinese, Japanese and Korean writing apart, every area with its
// first pages, and how the reference is made. The address, title and
// description are the old hub's, kept as they were; every marks page is still
// linked (the areas' rails and homes list them all).
import Reference from '../../layouts/Reference.astro';
import AppBox from '../../components/AppBox.astro';
import Portal from '../../islands/Portal';
import { collection, families, inScope, PER_RECORD, SEAL_KINDS } from '../../lib/portal';
import { AREAS, order, holdings, pictures } from '../../lib/reference';
import { media } from '../../lib/media';
import '../../styles/marks.css';
import '../../styles/portal.css';

const path = '/marks/';
const title = 'Marks and Serial Numbers: Date Silver, Singers, Watches | Heirloom';
const description = 'Date British silver by its hallmark letter, decode Wedgwood, Minton, Royal Worcester, Rookwood and Sèvres date codes, and look up Singer, pocket-watch and Leica serials.';

const c = collection();
const fams = families('marks');
const marks = c.records.filter((r) => !SEAL_KINDS.has(r.kind) && inScope(r.family, 'marks')).length;
const seals = c.records.filter((r) => SEAL_KINDS.has(r.kind) || r.kind === 'signature example').length;
const areas = AREAS().map((a) => ({ ...a, h: holdings(a), pics: pictures(a, 4), top: order(a).filter((l) => l.href !== a.href).slice(0, 5) }));
const n = (x: number) => x.toLocaleString('en-US');
// An area's name inside a sentence: countries keep their capital.
const inWords = (a: { key: string; short: string }) => (['china', 'japan', 'korea', 'india'].includes(a.key) ? a.short : a.short.charAt(0).toLowerCase() + a.short.slice(1));
const graph = [
  {
    '@type': 'CollectionPage', '@id': `https://heirloomapp.io${path}#page`, url: `https://heirloomapp.io${path}`, name: title, description,
    isPartOf: { '@id': 'https://heirloomapp.io/#website' },
    hasPart: areas.flatMap((a) => order(a)).map((l) => ({ '@type': 'WebPage', url: `https://heirloomapp.io${l.href}`, name: l.label })),
  },
];
---
<Reference {title} {description} {path} jsonld={graph} crumb="Reference" bare han="大明成化年製尙藥局有田" hangul="상약국한" ja="の九谷ノや">
  <div class="rhome">
    <header class="rhead">
      <h1>Marks, signatures and serial numbers</h1>
      <p class="rhead__lede">A reference to what is struck, painted, printed or signed on the things people own: {n(marks)} marks, date letters, reigns and makers, and {n(seals)} seals and signatures. Each record names its sources. Search, or start from what you see.</p>
    </header>

    <aside class="rwhy" aria-label="Why Heirloom builds this reference">
      <p class="rwhy__t">One of the ways we give back to the art world.</p>
      <p>Auction houses, dealers, museums, collectors and families all lean on mark references, and most of them still live in out-of-print books, photocopied tables and forum threads. They are a utility that was never modernized. This is ours, brought up to date: free to use, searchable in one place, readable on a phone, and with each record naming its sources. <a href="/app">Heirloom, the app</a> reads the same records.</p>
    </aside>

    <div class="rhome__search">
      <Portal client:load scope="marks" families={fams} perRecord={[...PER_RECORD]} sealCount={0} placeholder="A letter, a year, 925, 大明成化年製, Gorham, Meissen…" searchLabel="Search every mark, date letter, reign and maker" />
    </div>

    <section class="rhome__block" aria-labelledby="see">
      <h2 id="see">What do you see on it?</h2>
      <p class="rhome__intro">Turn the item over, or look along the rim, the back or the margin. Pick what is there.</p>
      <ul class="cues">
        {areas.map((a) => (
          <li>
            <a class="cue" href={a.href}>
              <span class="cue__pics">{a.pics.slice(0, 3).map((p) => <span class="plate plate--print"><img src={media(p)} alt="" loading="lazy" decoding="async" /></span>)}</span>
              <span class="cue__text">
                <span class="cue__see">{a.cue}</span>
                <span class="cue__go">{a.short}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="rhome__block" aria-labelledby="cjk">
      <h2 id="cjk"><span class="proper-name">Chinese, Japanese or Korean?</span></h2>
      <p class="rhome__intro">All three wrote with Chinese characters, so a mark in characters is not always Chinese. Look for these first.</p>
      <div class="tellapart">
        <div>
          <span class="sample han" lang="zh-Hant">大明成化年製</span>
          <h3>Only characters</h3>
          <p>Usually four or six, in a square, a double ring or two columns, naming a reign or a hall. Japanese and later Chinese potters copied these marks, so a Ming mark can be on a later or a Japanese item. <a href="/marks/chinese/">Chinese marks</a></p>
        </div>
        <div>
          <span class="sample ja" lang="ja">九谷 の ノ や</span>
          <h3>Characters with kana</h3>
          <p>Kana are simpler signs (の, ノ, や) mixed in with the characters. Also a kiln or a place name such as 九谷 (Kutani) or 有田 (Arita), and seals in the margin of a woodblock print. <a href="/marks/japanese/">Japanese marks</a></p>
        </div>
        <div>
          <span class="sample hangul" lang="ko">상약국 <span class="han" lang="zh-Hant">尙藥局</span></span>
          <h3>Hangul, or inlaid characters</h3>
          <p>Hangul builds each syllable from circles and strokes in a square (한). On older celadon, characters inlaid in white or black name a court office or a place. <a href="/marks/korean/">Korean marks</a></p>
        </div>
      </div>
    </section>

    <section class="rhome__block" aria-labelledby="areas">
      <h2 id="areas">The reference, part by part</h2>
      <ul class="areas">
        {areas.map((a) => (
          <li>
            <article class="areacard">
              <div class="areacard__head">
                <h3><a href={a.href}>{a.label}</a></h3>
                <span class="areacard__n num">{n(a.h.records)} records</span>
                <p class="areacard__lede">{a.lede}</p>
              </div>
              {a.pics.length > 0 && <span class="areacard__pics">{a.pics.map((p) => <span class="plate plate--print"><img src={media(p)} alt="" loading="lazy" decoding="async" /></span>)}</span>}
              <ul>{a.top.map((l) => <li><a href={l.href}>{l.label}{l.note && <span>{l.note}</span>}</a></li>)}</ul>
              <a class="areacard__all" href={a.href}>Every page in {inWords(a)} →</a>
            </article>
          </li>
        ))}
      </ul>
    </section>

    <section class="rhome__block" aria-labelledby="how">
      <h2 id="how">How the reference is made</h2>
      <ul class="principles">
        <li>
          <h3>Each fact names its source</h3>
          <p>Every record lists its sources, numbered: the books, catalogs, museum records and assay-office archives it comes from. Most facts are in two independent sources; a record with only one says so.</p>
        </li>
        <li>
          <h3>A mark says what it claims</h3>
          <p>Marks were copied, sometimes for centuries. A mark can be matched to a maker, a place and years; it cannot show that an item is genuine. Heirloom never decides that. A specialist who can handle the item is the one to ask.</p>
        </li>
        <li>
          <h3>Pictures say what they are</h3>
          <p>A photograph is of a real item, a book facsimile is a printed cut from a book, and a drawing is a drawing. Characters with no picture yet are set in type, and say so.</p>
        </li>
        <li>
          <h3>The same records the app reads</h3>
          <p>When Heirloom’s Advisor reads a mark in your photograph, it reads these records and links back to the one it matched, so you can check the reading yourself.</p>
        </li>
      </ul>
    </section>

    <AppBox text="Photograph the mark. The Advisor reads it, names what it claims (a maker, a reign, an assay office and year), and keeps the reading with the photo it came from." />
  </div>
</Reference>

<style>
  .rwhy { margin: 4px 0 28px; padding: 18px 22px; border-left: 3px solid var(--accent); background: var(--paper-2); border-radius: 0 var(--r-lg) var(--r-lg) 0; max-width: 92ch; }
  .rwhy p { margin: 0; color: var(--ink-2); font-size: 15.5px; line-height: 1.55; }
  .rwhy .rwhy__t { margin-bottom: 6px; font: 650 18px/1.3 var(--display); font-stretch: 106%; color: var(--ink); }
</style>
