---
// /marks/japanese/: the Japanese section's home, its catalogue. Every mark,
// seal, signature and crest in the app's table (backend/src/data/mark-tables/
// japanese.json, via the reference collection), grouped as the research groups
// them, each a row that opens into its sheet (components/ref/Catalogue); a
// character picker for readers who cannot type the characters. #<slug> and
// the explorer's old ?mark=<slug> both open a mark.
import Reference from '../../../layouts/Reference.astro';
import AppBox from '../../../components/AppBox.astro';
import Faq from '../../../components/Faq.astro';
import Catalogue from '../../../components/ref/Catalogue.astro';
import { jaSheet, CJK } from '../../../lib/records';
import { marks, GROUPS, pageChars } from '../../../lib/japanese';
import { articleLd, faqLd, crumbsLd } from '../../../lib/site';
import synced from '../../../data/app/SOURCE.json';

const path = '/marks/japanese/';
const rows = marks();
const by = (f: string) => rows.filter((r) => r.family === f).length;
const pictured = rows.filter((r) => r.photos.some((p) => p.visible === 'yes')).length;
const sheets = rows.map(jaSheet);
const groups = GROUPS.map((g) => ({ key: g.id, label: g.name, sheets: sheets.filter((x) => x.group === g.id) })).filter((g) => g.sheets.length);
// The characters on the marks, most used first, for the picker.
const freq = new Map<string, number>();
for (const r of rows) for (const ch of new Set([...r.chars, ...r.variants.join('')])) if (CJK.test(ch) && !/[\u3040-\u30ff]/.test(ch)) freq.set(ch, (freq.get(ch) ?? 0) + 1);
const picker = [...freq.entries()].sort((a, b) => b[1] - a[1]).slice(0, 160).map(([ch]) => ch);
const title = 'Japanese Pottery Marks, Print Seals and Signatures: Satsuma, Imari, Kutani | Heirloom';
const description = `${rows.length} marks, seals, signatures and crests on Japanese porcelain, pottery, woodblock prints, cloisonné, bronze and silver: what each names, when it was used, the copies to watch for, with sources in Japanese and English.`;
const h1 = 'Japanese marks, seals and signatures';
const faqs: [string, string][] = [
  ['How do I read the mark on the bottom of a Japanese vase?', '<p>Most marks are in kanji, read top to bottom and right to left when there are several columns. A mark usually names a kiln, a maker or a decorating studio (錦光山, Kinkōzan; 深川製, made by Fukagawa), sometimes with a place (大日本, Great Japan; 京都, Kyoto). Type the characters into the search above, or pick the ones you see, and only the marks that fit stay listed.</p>'],
  ['Does a Chinese reign mark mean my porcelain is Chinese?', '<p>Not on its own. Japanese kilns in Arita wrote Chinese reign marks such as 大明成化年製 on their porcelain from the 17th century on, sometimes with the 大 written 太. A reign mark names the era it claims; the body, glaze and painting decide where and when a piece was made.</p>'],
  ['Is a Satsuma vase with the cross in a circle old?', '<p>Not necessarily. The cross in a circle is the crest of the Shimazu family, lords of Satsuma, and it was painted on export Satsuma of the Meiji period and on a great many later pieces too. The mark tells you the piece claims to be Satsuma; it does not date it.</p>'],
  ['What does NIPPON or OCCUPIED JAPAN on porcelain mean?', '<p>Both are country-of-origin marks required on goods sold in the United States. NIPPON appears from 1891, after the 1890 tariff act; collectors date the change to JAPAN to 1921. MADE IN OCCUPIED JAPAN was used on exports during the Allied occupation, which ended on 28 April 1952. Reproductions carry these marks too.</p>'],
  ['Can a mark prove my Japanese item is genuine?', '<p>No. Japanese marks were passed down through generations of the same family, used by pupils, copied by other workshops and put on reproductions. A mark names who it claims; only someone who can handle the item can judge the rest.</p>'],
];
const graph = [
  articleLd(path, h1, description, (synced.changed as any).japanese ?? synced.changed.marks, { about: { '@type': 'Thing', name: 'Japanese ceramics and print marks' } }),
  faqLd(path, faqs),
  crumbsLd(path, h1, ['/marks/', 'Marks']),
];
const ja = pageChars(rows.map((r) => r.chars + r.variants.join('') + (r.kana ?? '') + r.meaning + (r.device ?? '') + (r.where ?? '') + (r.cautions ?? '') + (r.tells ?? '')).join('') + picker.join(''), '錦光山深川製廣重画純銀大明成化年製太京都日本寶宝廣広萬万會会製造筆大日本明治十五年');
---
<Reference {title} {description} {path} jsonld={graph} ja={ja}>
  <div>
    <header class="rhead">
      <h1>{h1}</h1>
      <p class="rhead__lede">The marks on Japanese things, from 17th-century Arita to post-war exports: {by('ceramics')} on porcelain and pottery, {by('prints')} seals and signatures on woodblock prints, {by('metal')} on cloisonné, bronze and silver, and {by('crests')} crests. Type or pick what is written on your item. A mark names what it claims, not when the item was made.</p>
      <ul class="rhead__meta">
        <li><strong class="num">{rows.length}</strong> marks, seals and crests</li>
        <li><strong class="num">{pictured}</strong> with a picture of the mark</li>
      </ul>
    </header>

    <Catalogue {groups} {picker} noun={['mark', 'marks, seals, signatures and crests']} placeholder="Characters, a reading or a name: 錦光山, Kinkozan, Fukagawa, Watanabe" label="Characters, a reading or a name" />

    <section class="ahome__block prose" aria-labelledby="read">
      <h2 id="read">How to read a Japanese mark</h2>
      <ul>
        <li>Marks are written in kanji, sometimes with kana. Several columns read from the right, each from the top.</li>
        <li>Many marks use the older forms of characters: 寶 for 宝, 廣 for 広, 萬 for 万, 會 for 会. The search reads both.</li>
        <li>製 (sei) and 造 (zō) both mean “made”; 画 or 筆 after a name means “painted by” or “drawn by”; 大日本 is “Great Japan”.</li>
        <li>A date written beside a mark, such as 明治十五年, can be worked out in the <a href="/marks/japanese-dates">date reader</a>. On a woodblock print the small censor and date seals date the design: <a href="/marks/japanese-print-seals">read them here</a>.</li>
      </ul>
      <h2 id="copies">A mark is not a date</h2>
      <p>Family names like Kinkōzan, Makuzu Kōzan and Kiyomizu Rokubei were used by generation after generation; Ninsei and Kenzan marks were written for centuries after the potters died; the censor seals of prints were cut on the blocks and reprinted with them. Of the {rows.length} records here, {pictured} have a picture showing the mark; the rest are set in type from the sources.</p>
    </section>

    <AppBox text="Photograph the mark. The Advisor reads the characters, names the maker or studio from this same table, works out any written date, and says plainly that a mark does not date the item." />
    <Faq {faqs} />
  </div>
</Reference>
