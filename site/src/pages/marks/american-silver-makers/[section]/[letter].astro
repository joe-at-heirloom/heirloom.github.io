---
// /marks/american-silver-makers/<section>/<letter>: one letter of a big section (the early silversmiths).
import DirLetter from '../../../../components/ref/DirLetter.astro';
import { places, DIRS, isSplit, letterSlug, type Place } from '../../../../lib/makers-dir';
import { placeGroups } from '../../../../lib/catalogues';
export function getStaticPaths() {
  return places(DIRS.american).filter(isSplit).flatMap((p) => placeGroups(p).map((g) => ({ params: { section: p.slug, letter: letterSlug(g.key) }, props: { p, key: g.key } })));
}
const { p, key } = Astro.props as { p: Place; key: string };
---
<DirLetter {p} {key} />
