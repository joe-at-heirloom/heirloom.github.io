---
// /marks/korean-folk-art: folk. Each entry from the app's table (korean.json `wares`,
// category "Folk painting (minhwa) and its subjects, screens, wrapping cloths and embroidery, and personal ornaments, with what tells 19th-century work from the copies made later.", via the reference collection): what it is, where it was made,
// how to recognize it, the copies the sources name, the evidence, and
// open-licence photographs. Rendered ahead of time on the guides' shared layout.
import Reference from '../../layouts/Reference.astro';
import AppBox from '../../components/AppBox.astro';
import Faq from '../../components/Faq.astro';
import KoreanGuide from '../../components/KoreanGuide.astro';
import { wares } from '../../lib/korean';
import { articleLd, faqLd, crumbsLd } from '../../lib/site';
import synced from '../../data/app/SOURCE.json';
import '../../styles/marks.css';
import '../../styles/portal.css';
import '../../styles/reigns.css';
import '../../styles/korean.css';

const path = '/marks/korean-folk-art';
const ws = wares('folk');
const SECTIONS: [string, string][] = [['painting', 'Folk painting and screens'], ['textiles', 'Wrapping cloths and embroidery'], ['ornaments', 'Personal ornaments'], ['later', 'Made later']];
const title = 'Korean Folk Painting, Screens, Wrapping Cloths and Ornaments | Heirloom';
const description = `${ws.length} Korean folk painting (minhwa) and screens, wrapping cloths (bojagi) and embroidery, and personal ornaments (norigae, hairpins): what each is, how to recognize older work, and how later production differs, with sources.`;
const h1 = 'Korean folk painting and textiles';
const faqs: [string, string][] = [['What is minhwa?', '<p>Korean folk painting: decorative pictures made for homes in the late Joseon period, mostly unsigned, of subjects that carried wishes, such as books and scholars’ objects (chaekgeori), the tiger and magpie, flowers and birds, and characters for the virtues (munjado). Many later copies exist.</p>'], ['What is a bojagi?', '<p>A Korean wrapping cloth, often pieced from scraps of silk or ramie in patchwork, or embroidered, used to wrap, carry and cover things.</p>']];
const graph = [
  articleLd(path, h1, description, (synced.changed as any).korean ?? synced.changed.marks, { about: { '@type': 'Thing', name: h1 } }),
  faqLd(path, faqs),
  crumbsLd(path, h1, ['/marks/korean/', 'Korean marks']),
];
const han = [...new Set(ws.map((w) => w.hanja ?? '').join(''))].filter((c) => /[㐀-鿿]/.test(c)).join('');
const hangul = [...new Set(ws.map((w) => w.hangul ?? '').join(''))].filter((c) => /[가-힣]/.test(c)).join('');
---
<Reference {title} {description} {path} jsonld={graph} {han} {hangul}>
  <div>
    <header class="phead">
      <h1>{h1}</h1>
      <p class="phead__sub">Folk painting (minhwa) and its subjects, screens, wrapping cloths and embroidery, and personal ornaments, with what tells 19th-century work from the copies made later.</p>
    </header>

    <KoreanGuide {ws} sections={SECTIONS} label={h1} places="Where made" />

    <AppBox text="Photograph the item from the front, the back, the inside and any marks or labels. The Advisor compares what it sees with this same guide and says what it cannot tell from photographs." />
    <Faq {faqs} />
  </div>
</Reference>
