---
// /marks/british-silver-makers/<town>: one town's makers' marks (components/ref/DirPlace.astro).
import DirPlace from '../../../components/ref/DirPlace.astro';
import { places, DIRS, type Place } from '../../../lib/makers-dir';
export function getStaticPaths() {
  return places(DIRS.british).map((p) => ({ params: { place: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Place };
---
<DirPlace {p} />
