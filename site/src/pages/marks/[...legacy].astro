---
// /marks/<page>: the reference pages the old generator made that no template
// has replaced yet (American plate, French, German, Russian and Mexican
// silver, Gorham, the purity guides, the serial-number lookups, Wedgwood,
// Minton, Worcester, Rookwood and Sèvres date codes, reading a signature).
// Each keeps its words, its title, its description and its structured data,
// read from the generated page itself (marks/<page>.html), and now sits in
// the reference's frame: crumbs, the area's rail, next and previous. Their
// lookups are the old marks/marks.js, which runs on load, so these pages are
// reached by a full page load (no view transition).
import { readdirSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import Reference from '../../layouts/Reference.astro';
import { astroRoutes } from '../../lib/reference';
import '../../styles/article.css';
import '../../styles/lookups.css';

export function getStaticPaths() {
  const dir = join(process.cwd(), '..', 'marks');
  const made = astroRoutes();
  return readdirSync(dir)
    .filter((f) => f.endsWith('.html') && f !== 'index.html' && !made.has(`/marks/${f.replace(/\.html$/, '')}`))
    .map((f) => ({ params: { legacy: f.replace(/\.html$/, '') }, props: { file: join(dir, f) } }));
}

const { legacy } = Astro.params as { legacy: string };
const { file } = Astro.props as { file: string };
const html = readFileSync(file, 'utf8');
const pick = (re: RegExp) => re.exec(html)?.[1] ?? '';
const unesc = (s: string) => s.replace(/&#x27;/g, '’').replace(/&#39;/g, '’').replace(/&quot;/g, '"').replace(/&amp;/g, '&');
const title = unesc(pick(/<title>([\s\S]*?)<\/title>/));
const description = unesc(pick(/<meta name="description" content="([^"]*)"/));
// The page's structured data, as it was (the frame replaces its breadcrumbs).
const graph: object[] = [];
for (const m of html.matchAll(/<script type="application\/ld\+json">([\s\S]*?)<\/script>/g)) {
  try {
    const j = JSON.parse(m[1]);
    for (const g of j['@graph'] ?? [j]) if (!['Organization', 'WebSite', 'BreadcrumbList'].includes(g['@type'])) graph.push(g);
  } catch {}
}
const main = html.slice(html.indexOf('<main'), html.indexOf('</main>'));
let article = /<article[^>]*>([\s\S]*)<\/article>/.exec(main)?.[1] ?? '';
article = article.replace(/<ol class="crumbs"[\s\S]*?<\/ol>/, '').replace(/<nav class="crumbs"[\s\S]*?<\/nav>/, '');
// Data the page's lookups read (window.WG = {...}), and the lookups themselves.
const inline = [...main.matchAll(/<script>([\s\S]*?)<\/script>/g)].map((m) => m[1]).filter((t) => !article.includes(t));
const lookups = /src="\/marks\/marks\.js"/.test(html);
const crumb = unesc(pick(/<h1[^>]*>([\s\S]*?)<\/h1>/).replace(/<[^>]+>/g, '')).trim();
const path = `/marks/${legacy}`;
---
<Reference {title} {description} {path} jsonld={graph} {crumb} transitions={false}>
  <div class="guide">
    <article set:html={article} />
  </div>
  {inline.map((t) => <script is:inline set:html={t} />)}
  {lookups && <script is:inline src="/marks/marks.js" defer></script>}
</Reference>
