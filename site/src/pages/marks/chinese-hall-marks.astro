---
// /marks/chinese-hall-marks: the hall and studio marks of the collection
// (family chinese-marks, kind hall mark), as a catalogue: each mark a row
// (its picture or its characters, the reading, what it means, the years) that
// opens into its sheet (whose hall, when, how written, where and in what
// color, found on, where the sources differ, the sources). Title, description
// and h1 are the generated page's (page-meta.json); every hall keeps its anchor.
import Reference from '../../layouts/Reference.astro';
import Catalogue from '../../components/ref/Catalogue.astro';
import AppBox from '../../components/AppBox.astro';
import { collection } from '../../lib/portal';
import { hallSheet, HALL_GROUPS, CJK } from '../../lib/records';
import { articleLd } from '../../lib/site';
import meta from '../../data/site/page-meta.json';

const path = '/marks/chinese-hall-marks';
const m = (meta as Record<string, { title: string | null; description: string | null; h1: string | null }>)[path];
const halls = collection().records.filter((r) => r.kind === 'hall mark').map(hallSheet);
const groups = HALL_GROUPS.map(([key, label, blurb]) => ({
  key, label, blurb,
  sheets: halls.filter((h) => h.group === key).sort((a, b) => (parseInt(a.years ?? '9999') || 9999) - (parseInt(b.years ?? '9999') || 9999) || a.reading.localeCompare(b.reading)),
}));
const pictured = halls.filter((h) => h.pics.length).length;
const sources = new Set(halls.flatMap((h) => h.sources.map((s) => s.citation))).size;
const title = m?.title ?? 'Chinese Hall Marks | Heirloom';
const description = m?.description ?? `${halls.length} Chinese hall and studio marks.`;
const han = [...new Set(JSON.stringify(halls).split('').filter((ch) => CJK.test(ch)))].join('') + '慎德堂製居仁';
const graph = [articleLd(path, 'Chinese hall marks', description, '2026-11-25')];
---
<Reference {title} {description} {path} jsonld={graph} {han}>
  <header class="rhead">
    <h1>{m?.h1 ?? 'Chinese hall marks'}</h1>
    <p class="rhead__lede">Instead of a reign, some Chinese porcelain names a hall, a studio or a palace building: <span class="han" lang="zh-Hant">慎德堂製</span>, “made for the Hall of Cautious Virtue.” Each mark below says whose hall it was, when its wares were made, how the mark is written, and where the sources disagree.</p>
    <ul class="rhead__meta">
      <li><strong class="num">{halls.length}</strong> halls and studios</li>
      <li><strong class="num">{pictured}</strong> with a photograph or a book’s cut</li>
      <li><strong class="num">{sources}</strong> sources, in Chinese and English</li>
    </ul>
  </header>

  <Catalogue {groups} noun={['hall mark', 'hall marks']} placeholder="Characters, pinyin or meaning: 慎德堂, shende, harmony" label="Characters, pinyin or meaning" />

  <section class="ahome__block read" aria-labelledby="rely">
    <h2 id="rely">Before you rely on a hall mark</h2>
    <p>A hall mark names the hall, studio or palace building an item was made for, or claims to be. Hall marks were copied too (<span class="han" lang="zh-Hant">慎德堂製</span> under Guangxu and in the Republic; <span class="han" lang="zh-Hant">居仁堂製</span> after 1916), so the mark alone does not date the item or show that it is genuine.</p>
    <p>Many hall names were used by more than one owner, and many private hall marks cannot be tied to a person: the same characters can belong to different households in different centuries.</p>
    <p>Heirloom never decides whether an item is genuine or made for the hall its mark names. A specialist who can handle it is the one to ask. For reign marks, see <a href="/marks/chinese-reign-marks">Chinese reign marks</a>.</p>
  </section>

  <AppBox text="Photograph the base. The Advisor reads the characters, names the reign or hall the mark claims, and keeps the reading with the photo it came from." />
</Reference>
