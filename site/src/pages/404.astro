---
// Any address heirloomapp.io does not have (Workers static assets serve this
// with a 404 status: wrangler.jsonc, not_found_handling "404-page").
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Heirloom" description="This page is not on heirloomapp.io." path="/404">
  <section class="wrap nf">
    <p class="nf__code num">404</p>
    <h1>This page isn’t here</h1>
    <p class="lede">The address may have a typo, or the page may have moved. These are the places most people are looking for.</p>
    <ul class="nf__links">
      <li><a href="/marks/"><span>Marks and serial numbers</span><span class="muted">Date silver, porcelain, pottery and watches by their marks</span></a></li>
      <li><a href="/marks/london-date-letters"><span>British date letters</span><span class="muted">London, Birmingham, Sheffield and Chester</span></a></li>
      <li><a href="/marks/chinese-reign-marks"><span>Chinese reign marks</span><span class="muted">Ming and Qing marks, with a finder</span></a></li>
      <li><a href="/"><span>Heirloom</span><span class="muted">The home inventory for the things that matter</span></a></li>
    </ul>
  </section>
</Base>
<style>
  .nf { padding-block: clamp(48px, 10vw, 120px) 0; max-width: 760px; }
  .nf__code { margin: 0 0 8px; font: 400 1.1rem/1 var(--serif); color: var(--accent-ink); }
  .nf h1 { margin-bottom: 16px; }
  .nf__links { list-style: none; margin: 40px 0 0; padding: 0; display: grid; gap: 10px; }
  .nf__links a { display: grid; gap: 2px; padding: 16px 20px; border: 1px solid var(--rule); border-radius: var(--r-lg); text-decoration: none; transition: border-color 0.2s, transform 0.2s var(--ease); }
  .nf__links a:hover { border-color: var(--ink-3); transform: translateY(-1px); color: inherit; }
  .nf__links a span:first-child { font: 500 1.15rem/1.3 var(--serif); }
  .nf__links a span:last-child { font-size: 14px; }
</style>
