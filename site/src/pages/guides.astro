---
// The guides hub. Moved from the generated HTML into Astro on Nov 25 2026 (Joe: "no
// more html, astro all the way"): the words, title and structured data live
// here now. American spelling, "item" and "specialist"; the copy check reads
// the built page (scripts/check-copy.mjs, COPY_CHECK_PAGES=site/dist).
import Base from '../layouts/Base.astro';
import { plainText } from '../lib/text';
import '../styles/guides.css';
const title = "Guides: Home Inventory, Antiques & Heirlooms | Heirloom";
const description = "Plain guides from Heirloom: making a home inventory for insurance, reading silver hallmarks, identifying antiques from photos, and documenting family heirlooms.";
const faq: { q: string; a: string }[] = [];
const jsonld: object[] = [
  {
    "@type": "CollectionPage",
    "@id": "https://heirloomapp.io/guides",
    "url": "https://heirloomapp.io/guides",
    "name": "Guides: Home Inventory, Antiques & Heirlooms | Heirloom",
    "description": "Plain guides from Heirloom: making a home inventory for insurance, reading silver hallmarks, identifying antiques from photos, and documenting family heirlooms.",
    "isPartOf": {
      "@id": "https://heirloomapp.io/#website"
    },
    "hasPart": [
      {
        "@type": "WebPage",
        "url": "https://heirloomapp.io/marks/",
        "name": "Marks and serial numbers"
      },
      {
        "@type": "WebPage",
        "url": "https://heirloomapp.io/home-inventory-app",
        "name": "Home inventory app"
      },
      {
        "@type": "WebPage",
        "url": "https://heirloomapp.io/antique-identifier-app",
        "name": "Antique identifier app"
      },
      {
        "@type": "WebPage",
        "url": "https://heirloomapp.io/home-inventory-checklist",
        "name": "Home inventory checklist"
      },
      {
        "@type": "WebPage",
        "url": "https://heirloomapp.io/silver-hallmarks",
        "name": "Silver hallmarks"
      },
      {
        "@type": "WebPage",
        "url": "https://heirloomapp.io/family-heirlooms",
        "name": "Family heirlooms"
      }
    ]
  },
  {
    "@type": "BreadcrumbList",
    "@id": "https://heirloomapp.io/guides#crumbs",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Heirloom",
        "item": "https://heirloomapp.io/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Guides",
        "item": "https://heirloomapp.io/guides"
      }
    ]
  }
];


---
<Base title={title} description={description} path="/guides" jsonld={jsonld}>
  <div class="wrap rp rp--guide">

    <article>
      <ol class="crumbs" aria-label="Breadcrumb"><li><a href="/">Heirloom</a></li><li aria-current="page">Guides</li></ol>
      <h1>Guides</h1>
      <p class="guide__lede">How to know what you own: making a home inventory, reading the marks on old things, and keeping the stories that go with them.</p>
      <ul class="cards"><li><a class="card" href="/marks/"><span class="card__title">Marks and serial numbers</span><span class="card__desc">Date British silver by its letter, and look up Singer, pocket-watch and Leica serial numbers.</span></a></li><li><a class="card" href="/home-inventory-app"><span class="card__title">Home inventory app</span><span class="card__desc">Walk your home room by room and make a PDF inventory your insurer can read.</span></a></li><li><a class="card" href="/antique-identifier-app"><span class="card__title">Antique identifier app</span><span class="card__desc">What an app can read in a photo of an antique, and what it cannot tell.</span></a></li><li><a class="card" href="/home-inventory-checklist"><span class="card__title">Home inventory checklist</span><span class="card__desc">Room by room, what to record for each item, and a free spreadsheet template.</span></a></li><li><a class="card" href="/silver-hallmarks"><span class="card__title">Silver hallmarks</span><span class="card__desc">How to read British, American and continental silver marks, and the marks that mean plate.</span></a></li><li><a class="card" href="/family-heirlooms"><span class="card__title">Family heirlooms</span><span class="card__desc">How to record an heirloom's story, keep its paperwork and decide who it is meant for.</span></a></li></ul>
<aside class="app-box" aria-labelledby="app-box-title">
  <h2 id="app-box-title">Start with one item</h2>
  <p>Heirloom is free on iPhone and on the web. Photograph an item, or write down what you already know about it, and add the rest room by room.</p>
  <div class="app-box__actions">
    <a class="store-badge" href="https://apps.apple.com/us/app/id6754576251"><img class="store-badge__art" src="/app-store-badge.svg" alt="Download Heirloom on the App Store" width="156" height="52"></a>
    <a class="btn btn--outline" href="https://web.heirloomapp.io">Open Heirloom on the web</a>
  </div>
  <p class="app-box__note">The iPhone app is in the US App Store for now. Heirloom on the web works everywhere, at <a href="https://web.heirloomapp.io">web.heirloomapp.io</a>.</p>
</aside>

    </article>
  </div>
</Base>
