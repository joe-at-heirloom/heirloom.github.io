    }
  },
  {
    "@type": "BreadcrumbList",
    "@id": "https://heirloomapp.io/home-inventory-app#crumbs",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Heirloom",
        "item": "https://heirloomapp.io/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Home inventory app",
        "item": "https://heirloomapp.io/home-inventory-app"
