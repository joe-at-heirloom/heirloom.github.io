    "@id": "https://heirloomapp.io/home-inventory-app",
    "url": "https://heirloomapp.io/home-inventory-app",
    "name": "Home Inventory App for Insurance, Room by Room | Heirloom",
    "description": "Heirloom is a free home inventory app for iPhone and the web. Photograph each room, keep serial numbers and receipts, and make a PDF your insurer can read.",
    "about": {
      "@id": "https://heirloomapp.io/#app"
    },
    "isPartOf": {
      "@id": "https://heirloomapp.io/#website"
    },
    "dateModified": "2026-11-22",
    "primaryImageOfPage": "https://heirloomapp.io/og-image.jpg"
  },
  {
    "@type": "MobileApplication",
    "@id": "https://heirloomapp.io/#app",
    "name": "Heirloom",
    "alternateName": "Heirloom: Know What You Own",
    "url": "https://heirloomapp.io/",
    "installUrl": "https://apps.apple.com/us/app/id6754576251",
    "operatingSystem": "iOS, Web",
    "applicationCategory": "LifestyleApplication",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
