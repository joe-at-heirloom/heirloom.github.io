---
// Home inventory app (search landing page). Moved from the generated HTML into Astro on Nov 25 2026 (Joe: "no
// more html, astro all the way"): the words, title and structured data live
// here now. American spelling, "item" and "specialist"; the copy check reads
// the built page (scripts/check-copy.mjs, COPY_CHECK_PAGES=site/dist).
import Base from '../layouts/Base.astro';
import { plainText } from '../lib/text';
import '../styles/guides.css';
const title = "Home Inventory App for Insurance, Room by Room | Heirloom";
const description = "Heirloom is a free home inventory app for iPhone and the web. Photograph each room, keep serial numbers and receipts, and make a PDF your insurer can read.";
const faq: { q: string; a: string }[] = [
  {
    "q": "Is Heirloom free?",
    "a": "<p>Yes. Heirloom is free to download from the US App Store and free to use on the web at <a href=\"https://web.heirloomapp.io\">web.heirloomapp.io</a>.</p>"
  },
  {
    "q": "Do I need a home inventory if I rent?",
    "a": "<p>Yes. Renters insurance covers your belongings, and after a fire, theft or flood you are asked to list what you lost. An inventory made beforehand, with photos and receipts, is far easier to rely on than memory.</p>"
  },
  {
    "q": "Do I need a photo of each item?",
    "a": "<p>No. You can write an item down without a photo, and it is a full record. Photos help most for valuable items, items with a serial number, and items you would struggle to describe.</p>"
  },
  {
    "q": "What does my insurer receive?",
    "a": "<p>Only what you choose to send. Heirloom prepares a PDF from the items you pick, room by room, with each item&rsquo;s photos, serial number, measurements, condition and replacement value with where that figure comes from. Receipts and other documents you attached are numbered as exhibits at the back. Heirloom keeps a record of what you sent, version by version.</p>"
  },
  {
    "q": "Does Heirloom tell me what my items are insured for, or value them?",
    "a": "<p>No. The PDF is an inventory aid, not an appraisal: the replacement figures are the ones you recorded, and the document does not confirm coverage. For art, jewelry or silver that needs its own coverage, ask your insurer what they need; it is often a written appraisal from an independent appraiser.</p>"
  },
  {
    "q": "Is my inventory private?",
    "a": "<p>Yes. Records are scoped to your account, photos live in private storage, family sharing is by invitation with a named role, and you can export or delete everything from Settings.</p>"
  },
  {
    "q": "Can I get my inventory out of Heirloom?",
    "a": "<p>Yes. Settings has a spreadsheet (one row per item, as a CSV file), a ZIP archive of your items and every photo that works without Heirloom, and all your data as a .json file.</p>"
  },
  {
    "q": "Where does Heirloom work?",
    "a": "<p>The iPhone app is in the US App Store for now. Heirloom on the web works everywhere, at web.heirloomapp.io.</p>"
  }
];
const jsonld: object[] = [
