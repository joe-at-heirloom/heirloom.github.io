---
// Antique identifier app (search landing page). Moved from the generated HTML into Astro on Nov 25 2026 (Joe: "no
// more html, astro all the way"): the words, title and structured data live
// here now. American spelling, "item" and "specialist"; the copy check reads
// the built page (scripts/check-copy.mjs, COPY_CHECK_PAGES=site/dist).
import Base from '../layouts/Base.astro';
import { plainText } from '../lib/text';
import '../styles/guides.css';
const title = "Antique Identifier App That Shows Its Evidence | Heirloom";
const description = "Photograph an antique: Heirloom reads its marks and labels, dates some from published tables, and says plainly what it cannot tell. Free on iPhone and the web.";
const faq: { q: string; a: string }[] = [
  {
    "q": "Is there a free app that identifies antiques from a photo?",
    "a": "<p>Heirloom is free on iPhone and on the web. Photograph an antique and its Advisor reads the marks, labels, materials and construction it can see, and writes down maker, period and materials where the evidence shows them. When the photos cannot settle a question, it says so, and asks for the one photo that would help.</p>"
  },
  {
    "q": "How accurate is an antique identifier app?",
    "a": "<p>Only as accurate as the evidence in the photos. A clear maker&rsquo;s mark, a hallmark or a printed label can often be read and dated; a plain chair with no marks often cannot be pinned down from photos alone. Heirloom labels each detail with how it is known (read from your photo, said by you, from a source, or likely) so you can tell a reading from a guess.</p>"
  },
  {
    "q": "Can the app tell me if my antique is real?",
    "a": "<p>No. Heirloom never decides whether an item is genuine. Marks can be worn, copied or added later, and judging that takes a specialist with the item in hand. In the United States you can ask Heirloom for an introduction to an independent appraiser or dealer you choose.</p>"
  },
  {
    "q": "Does Heirloom value antiques?",
    "a": "<p>No. Heirloom&rsquo;s estimates are informational only and are not professional appraisals. An estimate appears only when there is evidence for one, such as a recorded sale of a comparable item, and it is labeled as an estimate. For insurance, an estate or a donation, you need a written appraisal from an independent appraiser.</p>"
  },
  {
    "q": "How is this different from a reverse image search?",
    "a": "<p>A reverse image search finds pictures that look similar. Heirloom does run a visual search for similar items, and reads the marks and labels in your photos as well, then keeps what it found on the item&rsquo;s record, with where each finding came from, beside your photos and the item&rsquo;s story.</p>"
  },
  {
    "q": "What happens to my photos?",
    "a": "<p>Nothing leaves Heirloom until you allow the Advisor. If you do, your photos, notes and record details go to OpenAI to be read, and a photo link and a few details go to a search service that looks for similar items and auction records. Choose &ldquo;Record everything myself&rdquo; and nothing is sent to them. The <a href=\"/support#advisor-data\">support page</a> lists exactly what goes where.</p>"
  },
  {
    "q": "Is it only for antiques?",
    "a": "<p>No. Heirloom is a home inventory first: furniture, art, silver, ceramics, jewelry, watches, books and everyday things, room by room. Many keepsakes have no market value, and a record is complete without one.</p>"
  }
];
const jsonld: object[] = [
  {
    "@type": "WebPage",
    "@id": "https://heirloomapp.io/antique-identifier-app",
    "url": "https://heirloomapp.io/antique-identifier-app",
    "name": "Antique Identifier App That Shows Its Evidence | Heirloom",
    "description": "Photograph an antique: Heirloom reads its marks and labels, dates some from published tables, and says plainly what it cannot tell. Free on iPhone and the web.",
    "about": {
      "@id": "https://heirloomapp.io/#app"
    },
    "isPartOf": {
      "@id": "https://heirloomapp.io/#website"
    },
    "dateModified": "2026-11-22",
    "primaryImageOfPage": "https://heirloomapp.io/og-image.jpg"
  },
  {
    "@type": "BreadcrumbList",
    "@id": "https://heirloomapp.io/antique-identifier-app#crumbs",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Heirloom",
        "item": "https://heirloomapp.io/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Antique identifier app",
        "item": "https://heirloomapp.io/antique-identifier-app"
      }
    ]
  }
];
const faqPage = {"@type": "FAQPage", "@id": "https://heirloomapp.io/antique-identifier-app#faq"};
if (faq.length) jsonld.push({ ...faqPage, mainEntity: faq.map((f) => ({ '@type': 'Question', name: plainText(f.q), acceptedAnswer: { '@type': 'Answer', text: plainText(f.a) } })) });
---
<Base title={title} description={description} path="/antique-identifier-app" jsonld={jsonld}>
  <div class="wrap rp rp--guide">

    <article>
      <ol class="crumbs" aria-label="Breadcrumb"><li><a href="/">Heirloom</a></li><li aria-current="page">Antique identifier app</li></ol>
      <h1>An antique identifier that shows its evidence</h1>
      <p class="guide__lede">Photograph the attic find, the inherited silver or the chair from your grandmother&rsquo;s house. Heirloom reads what the photos show, says what they cannot, and keeps the answer with the item&rsquo;s story.</p>
      <p class="guide__meta">By Heirloom &middot; Updated <time datetime="2026-11-22">November 22, 2026</time></p>
      <div class="answer">
        <p class="answer__label">In short</p>
        <p>Heirloom is a free app for identifying antiques from photos, on iPhone and the web. Its Advisor reads the marks, labels, materials and condition it can see, dates some hallmarks, pottery marks and serial numbers from published tables, and says plainly what it cannot tell. It never decides whether an item is genuine, and an estimate appears only when there is evidence for one.</p>
      </div>

      <nav class="toc" aria-label="On this page">
        <p class="toc__title">On this page</p>
        <ol>
          <li><a href="#reads">What the Advisor reads in a photo</a></li>
          <li><a href="#photos">Photos that help, by kind of item</a></li>
          <li><a href="#unknown">When the answer is &ldquo;unknown&rdquo;</a></li>
          <li><a href="#value">Value, with one strict rule</a></li>
          <li><a href="#record">Then it is a record, not a search result</a></li>
          <li><a href="#faq">Questions</a></li>
        </ol>
      </nav>

      <h2 id="reads">What the Advisor reads in a photo</h2>
      <ul>
        <li><strong>Marks:</strong> silver hallmarks, pottery and porcelain backstamps, furniture makers&rsquo; stamps and labels, foundry marks on bronze.</li>
        <li><strong>Words:</strong> signatures, inscriptions, retailers&rsquo; labels, patent dates and serial numbers.</li>
        <li><strong>The item itself:</strong> its form, material, decoration, construction and condition.</li>
      </ul>
      <p>Some hallmarks, pottery marks and serial numbers can be dated from published tables, and a dated mark heads the record with the table it came from. Each detail says how it is known: read from your photo, said by you, from a source, or likely. The Advisor asks a question only when the answer would change something.</p>

      <h2 id="photos">Photos that help, by kind of item</h2>
      <p>Start with the whole item from the front, then the back or underside, then every mark close up and in focus. Daylight from the side shows stamped marks better than a flash.</p>
      <div class="table-wrap">
        <table>
          <thead><tr><th scope="col">Kind of item</th><th scope="col">Photograph</th></tr></thead>
          <tbody>
            <tr><th scope="row">Silver</th><td>Each hallmark in a row, close and sharp; the underside; any engraving. See <a href="/silver-hallmarks">how to read silver hallmarks</a>.</td></tr>
            <tr><th scope="row">Pottery and porcelain</th><td>The backstamp or impressed mark, the foot rim, and any chips or repairs.</td></tr>
            <tr><th scope="row">Furniture</th><td>Inside a drawer (the joints), the back, the underside, hardware, and any label or stamp.</td></tr>
            <tr><th scope="row">Paintings and prints</th><td>The signature, the whole back of the frame, and every label, stamp or inscription on it.</td></tr>
            <tr><th scope="row">Watches and clocks</th><td>The dial, the case back, and the movement with its serial number, if you can open it safely.</td></tr>
            <tr><th scope="row">Jewelry</th><td>Stamps inside a ring band or on a clasp, and the setting from the side.</td></tr>
          </tbody>
        </table>
      </div>

      <h2 id="unknown">When the answer is &ldquo;unknown&rdquo;</h2>
      <p>Many antiques carry no mark at all, and photos cannot show weight, smell, or the inside of a joint. When the evidence runs out, Heirloom writes &ldquo;unknown&rdquo; and, where one more photo would change that, says which. &ldquo;Unknown&rdquo; is a normal answer, not a failed record: the item still has its photos, its room and its story.</p>

      <h2 id="value">Value, with one strict rule</h2>
      <p>A figure is shown only with its source, and your own figure comes first. When the Advisor finds what comparable items sold for, it lists each sale with where it was found, its date and whether it sold or was only listed. An asking price or a look-alike never sets a figure on its own. Many items have no market value, and a record is complete without one.</p>
      <p class="note">Value estimates are informational only and are not professional appraisals. Sold prices, estimates and specialists are offered in the United States only for now.</p>

      <h2 id="record">Then it is a record, not a search result</h2>
      <p>Most identifier apps stop at an answer. Heirloom keeps it: the photos, what was read and where it came from, the story of who it came from in your own words, its room, and who it is meant for. Relatives you invite can add what they remember. When you need it, the same records become an <a href="/home-inventory-app">inventory for your insurer</a> or a family record.</p>
      <p>And if you are the collector who did the research years ago, write it down yourself. Your words and your estimates are never overwritten.</p>

<aside class="app-box" aria-labelledby="app-box-title">
  <h2 id="app-box-title">Start with one item</h2>
  <p>Heirloom is free on iPhone and on the web. Photograph an item, or write down what you already know about it, and add the rest room by room.</p>
  <div class="app-box__actions">
    <a class="store-badge" href="https://apps.apple.com/us/app/id6754576251"><img class="store-badge__art" src="/app-store-badge.svg" alt="Download Heirloom on the App Store" width="156" height="52"></a>
    <a class="btn btn--outline" href="https://web.heirloomapp.io">Open Heirloom on the web</a>
  </div>
  <p class="app-box__note">The iPhone app is in the US App Store for now. Heirloom on the web works everywhere, at <a href="https://web.heirloomapp.io">web.heirloomapp.io</a>.</p>
</aside>

      <h2 id="faq">Questions</h2>
<div class="faq">{faq.map((f) => (<details><summary set:html={f.q} /><div set:html={f.a} /></details>))}</div>

    </article>
    <section class="related" aria-labelledby="related-title"><p class="related__title" id="related-title">More from Heirloom</p><ul class="cards"><li><a class="card" href="/marks/"><span class="card__title">Marks and serial numbers</span><span class="card__desc">Date British silver by its letter, and look up Singer, pocket-watch and Leica serial numbers.</span></a></li><li><a class="card" href="/home-inventory-app"><span class="card__title">Home inventory app</span><span class="card__desc">Walk your home room by room and make a PDF inventory your insurer can read.</span></a></li><li><a class="card" href="/home-inventory-checklist"><span class="card__title">Home inventory checklist</span><span class="card__desc">Room by room, what to record for each item, and a free spreadsheet template.</span></a></li><li><a class="card" href="/silver-hallmarks"><span class="card__title">Silver hallmarks</span><span class="card__desc">How to read British, American and continental silver marks, and the marks that mean plate.</span></a></li><li><a class="card" href="/family-heirlooms"><span class="card__title">Family heirlooms</span><span class="card__desc">How to record an heirloom's story, keep its paperwork and decide who it is meant for.</span></a></li></ul></section>
  </div>
</Base>
