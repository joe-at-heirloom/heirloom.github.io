---
// Heirloom › section › page, as the generated pages had it.
const { name, mid } = Astro.props as { name: string; mid?: [string, string] };
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Heirloom</a></li>
    {mid && <li><a href={mid[0]}>{mid[1]}</a></li>}
    <li><span aria-current="page">{name}</span></li>
  </ol>
</nav>
<style>
  .crumbs ol { list-style: none; margin: 0; padding: 28px 0 0; display: flex; flex-wrap: wrap; gap: 6px; font-size: 14px; color: var(--ink-3); }
  .crumbs li + li::before { content: '/'; margin-right: 6px; color: var(--ink-3); opacity: 0.5; }
  .crumbs a { color: var(--ink-2); text-decoration: none; }
  .crumbs a:hover { color: var(--accent-ink); }
</style>
