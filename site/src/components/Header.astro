---
// One header for every page: the logo as it is, three sections, sign in and
// the app. On a phone the menu is a full-height sheet, not a squeezed row.
const { path } = Astro.props as { path: string };
const links = [
  { href: '/marks/', label: 'Marks and serials', note: 'Read the marks on silver, pottery, watches and more', match: ['/marks'] },
  { href: '/signatures', label: 'Signatures', note: 'Artists’ signatures, dated', match: ['/signatures'] },
  { href: '/app', label: 'The app', note: 'Your home’s inventory, ready for your insurer or your family', match: ['/app', '/home-inventory', '/antique-identifier'] },
  { href: '/guides', label: 'Guides', note: 'Inventories, hallmarks, heirlooms', match: ['/guides', '/silver-hallmarks', '/family-heirlooms'] },
];
const current = (l: (typeof links)[number]) => l.match.some((m) => path.startsWith(m));
---
<header class="hdr" transition:persist>
  <div class="wrap hdr__in">
    <a class="logo" href="/" aria-label="Heirloom, home">
      <img src="/logo.svg" alt="" width="128" height="23" />
    </a>
    <nav class="hdr__nav" aria-label="Main">
      {links.map((l) => <a href={l.href} aria-current={current(l) ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <div class="hdr__end">
      <button class="icon" type="button" aria-label="Switch light or dark" data-theme-toggle>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z" /></svg>
      </button>
      <a class="hdr__signin" href="https://web.heirloomapp.io">Sign in</a>
      <a class="btn btn--primary hdr__cta" href="https://apps.apple.com/us/app/id6754576251">Get Heirloom</a>
      <button class="hdr__menu" type="button" aria-expanded="false" aria-controls="sheet" data-menu>
        <span>Menu</span>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" /></svg>
      </button>
    </div>
  </div>
  <div class="sheet" id="sheet" hidden>
    <nav class="wrap sheet__in" aria-label="Menu">
      {links.map((l) => (
        <a class="sheet__link" href={l.href} aria-current={current(l) ? 'page' : undefined}>
          <span class="sheet__t">{l.label}</span>
          <span class="sheet__n">{l.note}</span>
        </a>
      ))}
      <div class="sheet__end">
        <a class="btn btn--primary" href="https://apps.apple.com/us/app/id6754576251">Get Heirloom for iPhone</a>
        <a class="btn" href="https://web.heirloomapp.io">Sign in on the web</a>
      </div>
    </nav>
  </div>
</header>

<script>
  function wire() {
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => {
      b.onclick = () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
      };
    });
    const btn = document.querySelector<HTMLButtonElement>('[data-menu]');
    const sheet = document.getElementById('sheet');
    if (!btn || !sheet) return;
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      sheet.hidden = !open;
      document.documentElement.classList.toggle('menu-open', open);
      const label = btn.querySelector('span');
      if (label) label.textContent = open ? 'Close' : 'Menu';
    };
    btn.onclick = () => set(btn.getAttribute('aria-expanded') !== 'true');
    sheet.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
  }
  wire();
  document.addEventListener('astro:after-swap', () => {
    try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
    document.documentElement.classList.remove('menu-open');
    wire();
  });
</script>

<style>
  .hdr { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 50; background: color-mix(in oklab, var(--paper) 94%, transparent); backdrop-filter: saturate(1.3) blur(14px); -webkit-backdrop-filter: saturate(1.3) blur(14px); border-bottom: 1px solid var(--rule); }
  .hdr__in { display: flex; align-items: center; gap: 36px; height: 68px; }
  .logo { display: block; flex: none; }
  .logo img { height: 22px; width: auto; }
  .hdr__nav { display: flex; gap: 26px; }
  .hdr__nav a { position: relative; padding: 6px 0; text-decoration: none; color: var(--ink-2); font-size: 15px; font-weight: 500; }
  .hdr__nav a:hover { color: var(--ink); }
  .hdr__nav a[aria-current='page'] { color: var(--ink); }
  .hdr__nav a[aria-current='page']::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--accent); }
  .hdr__end { margin-left: auto; display: flex; align-items: center; gap: 16px; }
  .icon { width: 38px; height: 38px; border-radius: var(--r-sm); border: 0; background: transparent; color: var(--ink-2); display: grid; place-items: center; cursor: pointer; }
  .icon:hover { background: var(--paper-2); color: var(--ink); }
  .icon svg { width: 17px; height: 17px; fill: currentColor; }
  .hdr__signin { font-size: 15px; font-weight: 500; color: var(--ink-2); text-decoration: none; }
  .hdr__signin:hover { color: var(--ink); }
  .hdr__cta { min-height: 40px; padding: 0 16px; font-size: 14.5px; }
  .hdr__menu { display: none; align-items: center; gap: 8px; height: 38px; padding: 0 12px; border: 1px solid var(--rule); border-radius: var(--r-sm); background: var(--paper); color: var(--ink); font: 500 14px/1 var(--text); cursor: pointer; }
  .hdr__menu svg { width: 16px; height: 16px; stroke: currentColor; stroke-width: 1.6; fill: none; }
  .sheet { position: fixed; inset: 68px 0 0 0; background: var(--paper); overflow-y: auto; border-top: 1px solid var(--rule); }
  .sheet__in { display: flex; flex-direction: column; padding-block: 12px calc(32px + env(safe-area-inset-bottom, 0px)); }
  .sheet__link { display: grid; gap: 4px; padding: 18px 0; border-bottom: 1px solid var(--rule); text-decoration: none; color: var(--ink); }
  .sheet__t { font: 680 26px/1.1 var(--display); font-stretch: 112%; letter-spacing: -0.015em; }
  .sheet__n { color: var(--ink-2); font-size: 15px; }
  .sheet__link[aria-current='page'] .sheet__t { color: var(--accent-ink); }
  .sheet__end { display: grid; gap: 10px; margin-top: 24px; }
  .sheet__end .btn { justify-content: center; min-height: 50px; }
  :global(html.menu-open) { overflow: hidden; }
  @media (max-width: 980px) { .hdr__nav { gap: 18px; } .hdr__signin { display: none; } }
  @media (max-width: 860px) {
    .hdr__in { height: 60px; gap: 12px; }
    .sheet { inset: 60px 0 0 0; }
    .hdr__nav, .hdr__cta, .hdr__signin { display: none; }
    .hdr__menu { display: inline-flex; }
    .logo img { height: 19px; }
  }
  @media (min-width: 861px) { .sheet { display: none; } }
</style>
