---
// One header for every page. The site is part app, part reference: the app
// comes first, then the reference (marks, signatures and serial numbers, by
// what you are holding: lib/reference.ts), then guides. Each door is a link to
// its section's own page, and the arrow beside it (or hovering either) opens a
// panel with everything behind it; search, sign in and Get Heirloom sit at the
// right. On a phone the same order fills a sheet, each section's name a link.
import { app, guides, APP_STORE, WEB_APP } from '../lib/nav';
import { AREAS, order } from '../lib/reference';
const { path } = Astro.props as { path: string };
// Which door a page sits behind, by the start of its address. The script
// below reads the same lists again after each page swap, since the header
// persists from page to page.
const match = {
  app: ['/app', '/home-inventory-app', '/antique-identifier-app'],
  ref: ['/marks', '/signatures'],
  guides: ['/guides', '/home-inventory-checklist', '/silver-hallmarks', '/family-heirlooms'],
};
const on = {
  app: match.app.some((h) => path.startsWith(h)),
  ref: match.ref.some((h) => path.startsWith(h)),
  guides: match.guides.some((h) => path.startsWith(h)),
};
const doors = [
  { id: 'p-app', label: 'The app', href: '/app', current: on.app, match: match.app },
  { id: 'p-ref', label: 'Reference', href: '/marks/', current: on.ref, match: match.ref },
  { id: 'p-guides', label: 'Guides', href: '/guides', current: on.guides, match: match.guides },
];
const here = (href: string) => path.replace(/\/$/, '') === href.replace(/\/$/, '');
// Each area with its first pages (its own, not those it lists from elsewhere).
const areas = AREAS().map((a) => ({ ...a, top: order(a).filter((l) => l.href !== a.href).slice(0, 3) }));
const arrow = '<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" /></svg>';
---
<header class="hdr" transition:persist>
  <div class="wrap hdr__in">
    <a class="logo" href="/" aria-label="Heirloom, home">
      <img src="/logo.svg" alt="" width="128" height="23" />
    </a>
    <nav class="hdr__nav" aria-label="Main">
      {doors.map((d) => (
        <div class="hdr__item" data-item={d.id} data-match={d.match.join(' ')} data-current={d.current ? '' : undefined}>
          <a class="hdr__door" href={d.href} aria-current={here(d.href) ? 'page' : d.current ? 'true' : undefined}>{d.label}</a>
          <button type="button" class="hdr__caret" aria-expanded="false" aria-controls={d.id} data-door={d.id} aria-label={`Show what is in ${d.label === 'The app' ? 'the app' : d.label.toLowerCase()}`}>
            <Fragment set:html={arrow} />
          </button>
        </div>
      ))}
    </nav>
    <div class="hdr__end">
      <form class="hdr__search" action="/marks/" method="get" role="search">
        <label class="visually-hidden" for="hdr-q">Search the reference</label>
        <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" /><path d="m13 13 4 4" /></svg>
        <input id="hdr-q" name="q" type="search" placeholder="A mark, a maker, a serial…" autocomplete="off" />
      </form>
      <button class="hdr__icon" type="button" aria-label="Switch light or dark" data-theme-toggle>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z" /></svg>
      </button>
      <a class="hdr__signin" href={WEB_APP}>Sign in</a>
      <a class="btn btn--primary hdr__cta" href={APP_STORE}>Get Heirloom</a>
      <button class="hdr__menu" type="button" aria-expanded="false" aria-controls="sheet" data-menu>
        <span>Menu</span>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" /></svg>
      </button>
    </div>
  </div>

  <!-- The app -->
  <div class="hp" id="p-app" hidden>
    <div class="wrap hp__in">
      <div class="hp__lead">
        <p class="eyebrow">The app</p>
        <a class="hp__t" href="/app">Your home’s inventory, room by room.</a>
        <p class="hp__d">The photos, the stories, and what each item’s marks say, ready for your insurer or your family.</p>
        <a class="hp__all" href="/app">Everything the app does →</a>
        <div class="hp__cta">
          <a class="btn btn--primary" href={APP_STORE}>Get Heirloom for iPhone</a>
          <a class="btn" href={WEB_APP}>Sign in on the web</a>
        </div>
      </div>
      <div class="hp__cols hp__cols--app">
        <ul class="hp__list">
          {app.map((r) => <li><a href={r.href}><strong>{r.label}</strong><span>{r.note}</span></a></li>)}
        </ul>
        <img class="hp__shot" src="/screens/01-rooms-440.webp" alt="Heirloom’s Home screen on iPhone: five rooms, each showing how many of its items are documented." width="180" height="390" loading="lazy" />
      </div>
    </div>
  </div>

  <!-- Reference -->
  <div class="hp" id="p-ref" hidden>
    <div class="wrap hp__in">
      <div class="hp__lead">
        <p class="eyebrow">Reference</p>
        <a class="hp__t" href="/marks/">Read the marks on what you own.</a>
        <p class="hp__d">Hallmarks, makers’ marks, reign marks, signatures and serial numbers, each with its sources. Free to use: one of the ways we give back to the art world.</p>
        <a class="hp__all" href="/marks/">The whole reference →</a>
        <p class="hp__search"><a href="/marks/">Search marks</a> · <a href="/signatures">Search signatures</a></p>
      </div>
      <ul class="hp__areas">
        {areas.map((a) => (
          <li>
            <a class="hp__area" href={a.href}><strong>{a.short}</strong><span>{a.cue}</span></a>
            <ul>{a.top.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Guides -->
  <div class="hp" id="p-guides" hidden>
    <div class="wrap hp__in">
      <div class="hp__lead">
        <p class="eyebrow">Guides</p>
        <a class="hp__t" href="/guides">How to do it yourself.</a>
        <p class="hp__d">Making a home inventory, reading hallmarks, and keeping the story with the things that have one.</p>
      </div>
      <ul class="hp__grid">
        {guides.map((r) => <li><a href={r.href}><strong>{r.label}</strong>{r.note && <span>{r.note}</span>}</a></li>)}
      </ul>
    </div>
  </div>

  <!-- Phone sheet -->
  <div class="hs" id="sheet" hidden>
    <div class="wrap hs__in">
      <section>
        <a class="hs__big" href="/app">The app <span aria-hidden="true">→</span></a>
        {app.map((r) => <a class="hs__link" href={r.href}><strong>{r.label}</strong><span>{r.note}</span></a>)}
        <div class="hs__end">
          <a class="btn btn--primary" href={APP_STORE}>Get Heirloom for iPhone</a>
          <a class="btn" href={WEB_APP}>Sign in on the web</a>
        </div>
      </section>
      <section>
        <a class="hs__big" href="/marks/">Reference <span aria-hidden="true">→</span></a>
        <form class="hs__search" action="/marks/" method="get" role="search">
          <label class="visually-hidden" for="sheet-q">Search the marks</label>
          <input class="field" id="sheet-q" name="q" type="search" placeholder="A mark, a maker, a serial…" autocomplete="off" />
        </form>
        {areas.map((a) => <a class="hs__link" href={a.href}><strong>{a.short}</strong><span>{a.cue}</span></a>)}
      </section>
      <section>
        <a class="hs__big" href="/guides">Guides <span aria-hidden="true">→</span></a>
        {guides.filter((r) => r.href !== '/guides').map((r) => <a class="hs__link" href={r.href}><strong>{r.label}</strong>{r.note && <span>{r.note}</span>}</a>)}
      </section>
    </div>
  </div>
  <div class="hdr__scrim" hidden></div>
</header>

<script>
  // The door of the page now showing: the header persists across page swaps.
  function mark() {
    const p = location.pathname;
    const bare = (h: string) => h.replace(/\/$/, '');
    document.querySelectorAll<HTMLElement>('.hdr__item').forEach((item) => {
      const on = (item.dataset.match ?? '').split(' ').some((h) => h && p.startsWith(h));
      item.toggleAttribute('data-current', on);
      const a = item.querySelector<HTMLAnchorElement>('.hdr__door');
      if (!a) return;
      const cur = bare(p) === bare(a.getAttribute('href') ?? '') ? 'page' : on ? 'true' : null;
      if (cur) a.setAttribute('aria-current', cur); else a.removeAttribute('aria-current');
    });
  }
  function wire() {
    mark();
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => {
      b.onclick = () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
      };
    });
    const doors = [...document.querySelectorAll<HTMLButtonElement>('[data-door]')];
    const scrim = document.querySelector<HTMLElement>('.hdr .hdr__scrim');
    let timer = 0;
    const show = (id: string | null) => {
      doors.forEach((d) => {
        const on = d.dataset.door === id;
        d.setAttribute('aria-expanded', String(on));
        const p = document.getElementById(d.dataset.door!);
        if (p) p.hidden = !on;
      });
      if (scrim) scrim.hidden = !id;
    };
    const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
    doors.forEach((d) => {
      d.onclick = () => show(d.getAttribute('aria-expanded') === 'true' ? null : d.dataset.door!);
      const item = d.closest<HTMLElement>('.hdr__item');
      if (canHover && item) {
        item.onmouseenter = () => { clearTimeout(timer); timer = window.setTimeout(() => show(d.dataset.door!), 90); };
        item.onmouseleave = () => { clearTimeout(timer); };
      }
    });
    document.querySelectorAll<HTMLElement>('.hdr .hp').forEach((p) => {
      if (canHover) {
        p.onmouseenter = () => clearTimeout(timer);
        p.onmouseleave = () => { timer = window.setTimeout(() => show(null), 200); };
      }
      p.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => show(null)));
    });
    const hdr = document.querySelector<HTMLElement>('.hdr');
    if (hdr && canHover) hdr.onmouseleave = () => { timer = window.setTimeout(() => show(null), 250); };
    if (scrim) scrim.onclick = () => show(null);

    const btn = document.querySelector<HTMLButtonElement>('[data-menu]');
    const sheet = document.getElementById('sheet');
    const setSheet = (open: boolean) => {
      if (!btn || !sheet) return;
      btn.setAttribute('aria-expanded', String(open));
      sheet.hidden = !open;
      document.documentElement.classList.toggle('menu-open', open);
      const label = btn.querySelector('span');
      if (label) label.textContent = open ? 'Close' : 'Menu';
    };
    if (btn && sheet) {
      btn.onclick = () => setSheet(btn.getAttribute('aria-expanded') !== 'true');
      sheet.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setSheet(false)));
    }
    document.onkeydown = (e) => { if (e.key === 'Escape') { show(null); setSheet(false); } };
  }
  wire();
  document.addEventListener('astro:after-swap', () => {
    try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
    document.documentElement.classList.remove('menu-open');
    wire();
  });
</script>

<style>
  /* No backdrop-filter here: it would make the header the containing block of the fixed phone menu and scrim. */
  .hdr { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 50; background: var(--paper); border-bottom: 1px solid var(--rule); }
  .hdr__in { display: flex; align-items: center; gap: 32px; height: 68px; }
  .logo { display: block; flex: none; }
  .logo img { height: 22px; width: auto; }
  .hdr__nav { display: flex; gap: 4px; }
  /* A door: the section's link and, beside it, the arrow that opens its panel. They read as one. */
  .hdr__item { position: relative; display: inline-flex; align-items: center; height: 40px; border-radius: var(--r-sm); }
  .hdr__door { white-space: nowrap; display: inline-flex; align-items: center; height: 40px; padding: 0 2px 0 12px; color: var(--ink-2); font: 500 15px/1 var(--text); text-decoration: none; border-radius: var(--r-sm) 0 0 var(--r-sm); }
  .hdr__caret { display: inline-grid; place-items: center; width: 28px; height: 40px; padding: 0 6px 0 2px; border: 0; border-radius: 0 var(--r-sm) var(--r-sm) 0; background: transparent; color: var(--ink-2); cursor: pointer; }
  .hdr__caret svg { width: 12px; height: 12px; stroke: currentColor; stroke-width: 1.6; fill: none; transition: transform 0.2s var(--ease); }
  .hdr__item:hover, .hdr__item:has([aria-expanded='true']) { background: var(--accent-wash); }
  .hdr__item:hover .hdr__door, .hdr__item:hover .hdr__caret, .hdr__caret[aria-expanded='true'], .hdr__item:has([aria-expanded='true']) .hdr__door { color: var(--accent-ink); }
  .hdr__door:hover { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .hdr__caret[aria-expanded='true'] svg { transform: rotate(180deg); }
  .hdr__door:focus-visible, .hdr__caret:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .hdr__item[data-current] .hdr__door { color: var(--ink); }
  .hdr__item[data-current]::after { content: ''; position: absolute; left: 12px; right: 10px; bottom: -14px; height: 2px; background: var(--accent); }
  .hdr__end { margin-left: auto; display: flex; align-items: center; gap: 14px; }
  .hdr__search { position: relative; display: flex; align-items: center; }
  .hdr__search svg { position: absolute; left: 11px; width: 16px; height: 16px; stroke: var(--ink-3); stroke-width: 1.6; fill: none; pointer-events: none; }
  .hdr__search input { width: 230px; height: 40px; padding: 0 12px 0 34px; border: 1px solid var(--rule); border-radius: var(--r-sm); background: var(--paper); color: var(--ink); font: 400 14.5px var(--text); }
  .hdr__search input::placeholder { color: var(--ink-3); }
  .hdr__search input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-wash); }
  .hdr__icon { width: 38px; height: 38px; border-radius: var(--r-sm); border: 0; background: transparent; color: var(--ink-2); display: grid; place-items: center; cursor: pointer; }
  .hdr__icon:hover { background: var(--paper-2); color: var(--ink); }
  .hdr__icon svg { width: 17px; height: 17px; fill: currentColor; }
  .hdr__signin { font-size: 15px; font-weight: 500; color: var(--ink-2); text-decoration: none; white-space: nowrap; }
  .hdr__signin:hover { color: var(--ink); }
  .hdr__cta { min-height: 40px; padding: 0 16px; font-size: 14.5px; white-space: nowrap; }
  .hdr__menu { display: none; align-items: center; gap: 8px; height: 38px; padding: 0 12px; border: 1px solid var(--rule); border-radius: var(--r-sm); background: var(--paper); color: var(--ink); font: 500 14px/1 var(--text); cursor: pointer; }
  .hdr__menu svg { width: 16px; height: 16px; stroke: currentColor; stroke-width: 1.6; fill: none; }

  .hp { position: absolute; left: 0; right: 0; top: 100%; z-index: 2; background: var(--paper); border-top: 2px solid var(--accent); border-bottom: 1px solid var(--rule); box-shadow: 0 24px 48px -24px rgb(31 33 36 / 0.25); }
  .hp__in { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr); gap: 48px; padding-block: 32px 36px; }
  .hp__lead { border-right: 1px solid var(--rule); padding-right: 32px; }
  .hp__t { display: block; font: 680 26px/1.12 var(--display); font-stretch: 112%; letter-spacing: -0.015em; margin: 10px 0 10px; color: var(--ink); text-decoration: none; }
  .hp__t:hover { color: var(--accent-ink); }
  .hp__d + .hp__all { display: inline-block; margin-bottom: 18px; }
  .hp__d { color: var(--ink-2); font-size: 15px; margin: 0 0 18px; }
  .hp__all { font-weight: 600; text-decoration: none; border-bottom: 1px solid var(--accent); }
  .hp__cta { display: grid; gap: 8px; }
  .hp__cta .btn { justify-content: center; }
  .hp__cols { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 40px; }
  .hp__cols--app { grid-template-columns: minmax(0, 1fr) 180px; align-items: start; }
  .hp__grid { list-style: none; margin: 10px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 28px; }
  .hp__list { list-style: none; margin: 10px 0 0; padding: 0; }
  .hp__grid a, .hp__list a { display: grid; gap: 1px; padding: 9px 0; border-bottom: 1px solid var(--rule); text-decoration: none; }
  .hp__grid strong, .hp__list strong { font-weight: 600; font-size: 15px; }
  .hp__grid span, .hp__list span { font-size: 13.5px; color: var(--ink-2); }
  .hp__grid a:hover strong, .hp__list a:hover strong, .hp__list--plain a:hover { color: var(--accent-ink); }
  .hp__grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .hp__names { list-style: none; margin: 10px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 20px; }
  .hp__names a { display: block; padding: 8px 0; border-bottom: 1px solid var(--rule); text-decoration: none; font-size: 15px; }
  .hp__names a:hover { color: var(--accent-ink); }
  .hp__sub { margin-top: 22px; }
  .hp__search { margin: 14px 0 0; font-size: 14px; color: var(--ink-3); }
  .hp__search a { color: var(--ink-2); }
  .hp__areas { list-style: none; margin: 4px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 22px 26px; }
  .hp__area { display: grid; gap: 2px; padding-bottom: 8px; border-bottom: 1px solid var(--rule); text-decoration: none; }
  .hp__area strong { font-weight: 650; font-size: 15.5px; }
  .hp__area span { font-size: 13px; color: var(--ink-3); line-height: 1.35; }
  .hp__area:hover strong { color: var(--accent-ink); }
  .hp__areas ul { list-style: none; margin: 6px 0 0; padding: 0; display: grid; }
  .hp__areas ul a { display: block; padding: 4px 0; font-size: 14px; color: var(--ink-2); text-decoration: none; }
  .hp__areas ul a:hover { color: var(--accent-ink); }
  @media (max-width: 1180px) { .hp__areas { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .hp__shot { width: 180px; height: auto; border-radius: 20px; box-shadow: var(--shadow-lift); }
  .hdr__scrim { position: fixed; inset: 68px 0 0 0; background: rgb(31 33 36 / 0.18); z-index: 1; }

  .hs { position: fixed; inset: 60px 0 0 0; background: var(--paper); overflow-y: auto; border-top: 1px solid var(--rule); z-index: 3; }
  .hs__in { display: grid; gap: 28px; padding-block: 16px calc(32px + env(safe-area-inset-bottom, 0px)); }
  .hs section { display: grid; }
  .hs .eyebrow { margin: 0 0 4px; }
  .hs__big { display: flex; justify-content: space-between; align-items: baseline; font: 680 24px/1.15 var(--display); font-stretch: 112%; color: var(--ink); text-decoration: none; padding: 6px 0 12px; border-bottom: 2px solid var(--accent); }
  .hs__big span { color: var(--accent-ink); font-weight: 500; }
  .hs__link { display: grid; gap: 2px; padding: 12px 0; border-bottom: 1px solid var(--rule); text-decoration: none; }
  .hs__link strong { font-weight: 600; font-size: 16.5px; }
  .hs__link span { font-size: 14px; color: var(--ink-2); }
  .hs__end { display: grid; gap: 10px; margin-top: 14px; }
  .hs__search { margin: 4px 0 6px; }
  .hs__end .btn { justify-content: center; min-height: 50px; }
  /* Lock the body, not the root: body has overflow-x: hidden, so a locked root would make body its own scroll box and the sticky header would scroll away with the page. */
  :global(html.menu-open body) { overflow: hidden; }

  @media (max-width: 1280px) { .hdr__search input { width: 180px; } }
  @media (max-width: 1180px) { .hdr__search { display: none; } }
  @media (max-width: 1040px) { .hdr__in { gap: 18px; } .hdr__door { padding: 0 1px 0 9px; } }
  @media (max-width: 900px) {
    .hdr__in { height: 60px; gap: 12px; }
    .hdr__nav, .hdr__cta, .hdr__signin, .hp, .hdr__scrim { display: none !important; }
    .hdr__menu { display: inline-flex; }
    .logo img { height: 19px; }
  }
  @media (min-width: 901px) { .hs { display: none !important; } }
</style>
