---
// One record in full, as it opens in a catalogue: what the mark means, the
// facts, where the sources differ, a caution, the sources numbered; beside it
// the mark's pictures, each with its credit.
import Spec from './Spec.astro';
import { statusWord, type Sheet } from '../../lib/records';
const { s } = Astro.props as { s: Sheet };
const [lead, ...more] = s.pics;
---
<div class="sheet2">
  <div class="sheet2__body">
    {s.means && <p class="sheet2__means">{s.means}</p>}
    {s.facts.length > 0 && (
      <dl class="facts2">
        {s.facts.map((f) => <><dt>{f.label}</dt><dd lang={f.label === 'Also written' ? (s.lang === 'ja' ? 'ja' : s.lang === 'ko' ? 'ko' : 'zh-Hant') : undefined} class:list={[{ han: f.label === 'Also written' }]}>{f.text}</dd></>)}
      </dl>
    )}
    {s.caution && <p class="caution"><strong>Careful: </strong>{s.caution}</p>}
    {s.differ.length > 0 && (
      <div class="differ">
        <h4>Where the sources differ</h4>
        <dl>
          {s.differ.map((d) => (
            <div>
              <dt>{d.label}</dt>
              <dd><ul>{d.values.map((v) => <li>{v.text}{v.refs.length > 0 && <span class="refs"> {v.refs.join(', ')}</span>}</li>)}</ul></dd>
            </div>
          ))}
        </dl>
      </div>
    )}
    {s.sources.length > 0 && (
      <div class="sheet2__src">
        <h4>Sources</h4>
        <!--copy-check:skip--><ol>
          {s.sources.map((x) => <li>{x.url ? <a href={x.url} rel="nofollow noopener">{x.citation}</a> : x.citation}{x.where && <span class="where">, {x.where}</span>}</li>)}
        </ol><!--/copy-check:skip-->
      </div>
    )}
    {s.single && <p class="onesrc">Only one source records this so far; read it as that source’s account.</p>}
  </div>
  {s.pics.length > 0 && (
    <div class="sheet2__aside">
      <figure class="sheet2__fig">
        <Spec pic={lead} label px={260} />
        <figcaption>{statusWord(lead.status)}{lead.credit && <>. {lead.url ? <a href={lead.url} rel="nofollow noopener">{lead.credit}</a> : lead.credit}</>}</figcaption>
      </figure>
      {more.length > 0 && (
        <div class="sheet2__more">
          {more.slice(0, 6).map((p) => <a href={p.url ?? p.file} title={`${statusWord(p.status)}. ${p.credit}`} rel="nofollow noopener"><Spec pic={p} px={80} /></a>)}
        </div>
      )}
    </div>
  )}
</div>
