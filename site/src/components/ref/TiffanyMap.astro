---
// The Tiffany windows map: the states (from the Census boundary file, drawn
// once in hallmark-sources/tiffany/build_map.py), one dot per town that the
// lists name, larger where more buildings are listed. A state links to its
// page; a dot to its town on that page. `focus` zooms to one state.
import { usMap, dots, places, BASE, type Site } from '../../lib/tiffany';

interface Props { focus?: string | null; label: string; filter?: (s: Site) => boolean }
const { focus = null, label, filter } = Astro.props;
const m = usMap();
const pts = dots(filter);
const pageOf = new Map(places().map((p) => [p.sites[0]?.state, p.path]));
// The view: the whole map, or the box around one state's outline and its dots.
let vb = [0, 0, m.width, m.height];
if (focus) {
  const st = m.states.find((s) => s.code === focus);
  const xs: number[] = [], ys: number[] = [];
  if (st) for (const [, x, y] of st.d.matchAll(/(-?\d+(?:\.\d+)?),(-?\d+(?:\.\d+)?)/g)) { xs.push(+x); ys.push(+y); }
  for (const d of pts) { xs.push(d.x); ys.push(d.y); }
  if (xs.length) {
    const pad = 18;
    let [x0, x1, y0, y1] = [Math.min(...xs) - pad, Math.max(...xs) + pad, Math.min(...ys) - pad, Math.max(...ys) + pad];
    // keep the frame's shape (8:5) so a small state is not stretched thin
    const w = x1 - x0, h = y1 - y0, want = m.width / m.height;
    if (w / h > want) { const nh = w / want; y0 -= (nh - h) / 2; y1 = y0 + nh; } else { const nw = h * want; x0 -= (nw - w) / 2; x1 = x0 + nw; }
    vb = [x0, y0, x1 - x0, y1 - y0].map((v) => Math.round(v * 10) / 10);
  }
}
const k = vb[2] / m.width; // dots and lines keep their size when zoomed
const r = (n: number) => Math.round((2.2 + Math.sqrt(n) * 1.7) * Math.max(k, 0.13) * 10) / 10;
const total = pts.reduce((a, d) => a + d.n, 0);
---
<figure class="twmap">
  <svg viewBox={vb.join(' ')} role="img" aria-label={label} preserveAspectRatio="xMidYMid meet">
    <g class="twmap__states">
      {m.states.map((s) => {
        const href = pageOf.get(s.code);
        const cls = s.code === focus ? 'is-focus' : href ? 'has' : '';
        return href && s.code !== focus
          ? <a href={href} aria-label={`Tiffany windows in ${s.name}`}><path d={s.d} class={cls} /></a>
          : <path d={s.d} class={cls}><title>{s.name}</title></path>;
      })}
    </g>
    <g class="twmap__dots">
      {pts.map((d) => (
        <a href={d.href}>
          <circle cx={d.x} cy={d.y} r={r(d.n)}><title>{`${d.town}, ${d.state}: ${d.n} ${d.n === 1 ? 'building' : 'buildings'}`}</title></circle>
        </a>
      ))}
    </g>
  </svg>
  <figcaption>One dot for each town the lists name, larger where they name more buildings ({total.toLocaleString('en-US')} buildings in all on this map). {focus ? 'Tap a dot to go to its town.' : 'Tap a state for its page, or a dot for its town.'}</figcaption>
</figure>

<style>
  .twmap { margin: 28px 0 0; }
  .twmap svg { display: block; width: 100%; height: auto; background: var(--paper-2); border-radius: var(--r-lg); }
  .twmap__states path { fill: var(--plate); stroke: var(--paper); stroke-width: 1.1; vector-effect: non-scaling-stroke; transition: fill 0.15s var(--ease); }
  .twmap__states path.has { fill: var(--plate-edge); }
  .twmap__states a:hover path, .twmap__states a:focus-visible path { fill: var(--wood); }
  .twmap__states path.is-focus { fill: var(--wood); opacity: 0.55; }
  .twmap__dots circle { fill: var(--accent); fill-opacity: 0.72; stroke: var(--paper); stroke-width: 0.8; vector-effect: non-scaling-stroke; }
  .twmap__dots a:hover circle, .twmap__dots a:focus-visible circle { fill: var(--ink); fill-opacity: 1; }
  .twmap figcaption { margin-top: 10px; font-size: 14px; color: var(--ink-3); max-width: 70ch; }
</style>
