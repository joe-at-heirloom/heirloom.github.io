---
// A mark, shown as it is: its picture on a print plate (a photograph of the
// item, a book's printed cut, or a drawing, said in a word), or, when there
// is no picture, its characters set in type in columns, read from the top of
// the right-hand column as a mark on a base is, and labelled as set in type.
// With neither, a plain outline: never a drawn stand-in.
import { statusWord, CJK, faceOf, type Pic } from '../../lib/records';
interface Props { pic?: Pic | null; glyphs?: string | null; lang?: 'zh' | 'ja' | 'ko' | null; px?: number; label?: boolean; alt?: string }
const { pic = null, glyphs = null, lang = null, px = 64, label = false, alt } = Astro.props;

// The characters only (a mark written "丸に松 / 角松" shows its first form).
const chars = [...String(glyphs ?? '').split(/\s*\/\s*|、/)[0]].filter((c) => CJK.test(c));
const n = chars.length;
// Characters per column, as marks are usually laid out: two by two for four,
// two columns of three for six, columns of two for eight (康熙辛亥中和堂製).
const per = n <= 3 ? Math.max(n, 1) : n === 4 ? 2 : n <= 6 ? 3 : n <= 8 ? 2 : 3;
const cols = Math.ceil(n / per);
const size = Math.max(10, Math.floor((px * 0.72) / Math.max(per, cols) / 1.08));
const { cls, lang: langAttr } = faceOf(chars.join(''), lang);
---
{pic ? (
  <span class="spec plate plate--print spec--print">
    <img src={pic.file} alt={alt ?? pic.alt} loading="lazy" decoding="async" />
    {label && <span class="spec__how">{statusWord(pic.status)}</span>}
  </span>
) : n > 0 ? (
  <span class="spec spec--type" title="Set in type: not a picture of the mark">
    <span class:list={['spec__cols', cls]} lang={langAttr} style={`--spec-size:${size}px; inline-size:${(per * 1.1).toFixed(2)}em`} aria-label={chars.join('')}>{chars.join('')}</span>
    {label && <span class="spec__how">Set in type</span>}
  </span>
) : (
  <span class="spec spec--none" aria-hidden="true"></span>
)}
<style>
  .spec--none { background: transparent; border-style: dashed; }
</style>
