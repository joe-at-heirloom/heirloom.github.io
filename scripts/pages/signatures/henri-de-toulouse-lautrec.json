{
 "artist": "Henri de Toulouse-Lautrec",
 "slug": "henri-de-toulouse-lautrec",
 "born": 1864,
 "died": 1901,
 "nationality": "French",
 "facts": [
  {
   "text": "As a teenager he signed with his HTL monogram and 'Monfa', from the family name Toulouse-Lautrec-Monfa, as on The Trap (1880).",
   "source": "https://www.nga.gov/collection/art-object-page.89686.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "From the late 1880s his usual painted signature joins the initials H and T in a ligature and continues with the surname, read 'HTLautrec' or 'THLautrec'.",
   "source": "https://www.nga.gov/collection/art-object-page.53140.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "In his lithographs the signature is often an HTL monogram in a circle drawn on the stone, sometimes with the year, as on the Jane Avril poster of 1899.",
   "source": "https://www.nga.gov/collection/art-object-page.42691.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "Many individual impressions are also signed in pencil below the image, 'THLautrec', sometimes with a number.",
   "source": "https://www.nga.gov/collection/art-object-page.66590.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "Works from his studio carry a red 'HTL' estate stamp in a circle (Lugt 1338).",
   "source": "https://www.nga.gov/collection/art-object-page.46696.html",
   "source_name": "National Gallery of Art"
  }
 ],
