{
 "artist": "Mary Cassatt",
 "slug": "mary-cassatt",
 "born": 1844,
 "died": 1926,
 "nationality": "American",
 "facts": [
  {
   "text": "Cassatt signed her paintings and pastels with her full name, 'Mary Cassatt', usually at the lower right and without a date.",
   "source": "https://www.nga.gov/collection/art-object-page.46574.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "An early portrait of her nephew is inscribed rather than signed: 'Eddy / from / Aunt Mary' (1875).",
   "source": "https://www.nga.gov/collection/art-object-page.165887.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "Her 1890–91 colour prints are pencil-signed below the image with a note that she printed them with M. Leroy in an edition of 25: 'Imprimée par l'artiste et M. Leroy / Mary Cassatt / (25 épreuves)'.",
   "source": "https://www.nga.gov/collection/art-object-page.46731.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "Some impressions are only initialled 'M.C' in pencil, and some carry a stamped 'MC' monogram.",
   "source": "https://www.nga.gov/collection/art-object-page.71035.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "Signatures scratched into a printing plate or picked up on a counterproof read backwards, as on The Crocheting Lesson (c. 1902).",
   "source": "https://www.nga.gov/collection/art-object-page.5942.html",
   "source_name": "National Gallery of Art"
  }
 ],
