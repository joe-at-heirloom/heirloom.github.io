{
 "artist": "Henri Matisse",
 "slug": "henri-matisse",
 "born": 1869,
 "died": 1954,
 "nationality": "French",
 "facts": [
  {
   "text": "On the 1913 lithograph Nude in a Rocking Chair, Matisse's initials 'H.M' are drawn in the stone and printed, and each sheet is also signed 'Henri - Matisse' and numbered by hand in pen.",
   "source": "https://open.smk.dk/artwork/image/KKS10070",
   "source_name": "Statens Museum for Kunst"
  },
  {
   "text": "His 1920s lithographs, such as the 1927 Dix danseuses portfolio, are signed 'Henri - Matisse' in pencil together with the edition number (for example '97/130').",
   "source": "https://open.smk.dk/artwork/image/KKS10289/1",
   "source_name": "Statens Museum for Kunst"
  },
  {
   "text": "On the 1923 etching Femme au collier the signature 'Henri Matisse' is etched into the plate and prints mirror-reversed.",
   "source": "https://open.smk.dk/artwork/image/KKS17799",
   "source_name": "Statens Museum for Kunst"
  },
  {
   "text": "The 1909 painting Nude with a White Scarf is signed with a two-digit date: 'Henri-Matisse 09'.",
   "source": "https://open.smk.dk/artwork/image/KMSr81",
   "source_name": "Statens Museum for Kunst"
  }
 ],
