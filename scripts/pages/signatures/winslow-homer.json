{
 "artist": "Winslow Homer",
 "slug": "winslow-homer",
 "born": 1836,
 "died": 1910,
 "nationality": "American",
 "facts": [
  {
   "text": "Homer's Civil War field drawings of 1862 are signed simply 'Homer' with the year, in graphite.",
   "source": "https://www.nga.gov/collection/art-object-page.98215.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "Through the 1870s and 1880s his watercolours are most often signed 'HOMER' in capitals with the year, sometimes shortened to an apostrophe and two digits, as in 'HOMER '89'.",
   "source": "https://www.nga.gov/collection/art-object-page.55585.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "On The Red School House (1873) a signature 'Homer 1873' was scratched into the wet paint and then painted over; the visible signature reads 'HOMER / 1873'.",
   "source": "https://www.nga.gov/collection/art-object-page.66419.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "Yachting Girl (1880) carries a copyright notice in his hand: 'Copyright - 1880 Winslow Homer'.",
   "source": "https://www.nga.gov/collection/art-object-page.164932.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "Homer sometimes added a dedication years after a work was made: Hauling in the Nets, signed 'Winslow Homer 87', is also inscribed 'To Mr M.F. King. with compliments of the Artist Sept 30th 1893'.",
   "source": "https://www.nga.gov/collection/art-object-page.55581.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "Danger, a watercolour begun in 1883, is signed twice: 'Winslow Homer / 1883' and 'Winslow Homer 87'.",
   "source": "https://www.nga.gov/collection/art-object-page.64551.html",
   "source_name": "National Gallery of Art"
  }
 ],
