{
 "artist": "Paul Gauguin",
 "slug": "paul-gauguin",
 "born": 1848,
 "died": 1903,
 "nationality": "French",
 "facts": [
  {
   "text": "Gauguin often wrote a dedication above his signature on works given to friends, as on Still Life with Peonies (1884): \"à M. Théodore Gad son ami / P Gauguin 84\".",
   "source": "https://www.nga.gov/collection/art-object-page.93046.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "He signed his 1889 Self-Portrait \"P Go\" under the date; the same short form, written \"PGo\" or \"PGO\", appears on other works such as the drawing Nave Nave Fenua (probably 1894).",
   "source": "https://www.nga.gov/collection/art-object-page.46625.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "Gauguin inscribed Tahitian titles on most of the 66 paintings he took back to Paris in 1892; on Parau na te Varua ino he signed, dated and inscribed the title in the lower left corner.",
   "source": "https://www.nga.gov/collection/art-object-page.53130.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "In the Noa Noa woodcuts of 1893–94 he cut the monogram \"PGO\" into the block beside the Tahitian title.",
   "source": "https://www.nga.gov/collection/art-object-page.39312.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "Impressions of the Noa Noa woodcuts printed in 1921, after his death, carry the monogram cut in the block and a pencil note \"Paul Gauguin fait\" below the image rather than a signature in his hand.",
   "source": "https://www.nga.gov/collection/art-object-page.30257.html",
   "source_name": "National Gallery of Art"
  }
 ],
