{
 "artist": "Albrecht Dürer",
 "slug": "albrecht-durer",
 "born": 1471,
 "died": 1528,
 "nationality": "German",
 "facts": [
  {
   "text": "On Adam and Eve (1504) Dürer put his full Latin name on a hanging tablet: 'ALBERT DVRER NORICVS FACIEBAT', followed by the AD monogram and the date.",
   "source": "https://www.nga.gov/collection/art-object-page.6609.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "Marcantonio Raimondi engraved copies of Dürer's prints around 1506–1508, duplicating Dürer's monogram as well.",
   "source": "https://exhibitions.psu.edu/s/recent-acquisitions/item/4791",
   "source_name": "Palmer Museum of Art, Penn State"
  },
  {
   "text": "Vasari reports that Dürer went to Venice to petition the Senate against Marcantonio's copies, but the story may be apocryphal: the Senate archives contain no mention of the petition.",
   "source": "https://exhibitions.psu.edu/s/recent-acquisitions/item/4791",
   "source_name": "Palmer Museum of Art, Penn State"
  },
  {
   "text": "Dürer's monogram was itself added to works by later hands: the National Gallery of Art records a false monogram added beside the artist's own inscription on his 1504 drawing The Entombment.",
   "source": "https://www.nga.gov/collection/art-object-page.53144.html",
   "source_name": "National Gallery of Art"
  }
 ],
