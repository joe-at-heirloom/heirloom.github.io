{
 "artist": "Rembrandt van Rijn",
 "slug": "rembrandt",
 "born": 1606,
 "died": 1669,
 "nationality": "Dutch",
 "facts": [
  {
   "text": "Rembrandt's earliest signed painting, dated 1625, carries a capital R; he then added an H, sometimes with an f for fecit ('made').",
   "source": "https://www.theleidencollection.com/essays/the-signing-of-paintings-by-rembrandt-and-his-contemporaries/",
   "source_name": "The Leiden Collection"
  },
  {
   "text": "In 1628 he added an L, read as Leydensis ('from Leiden'), giving the RHL monogram; he abandoned the L in the course of 1632.",
   "source": "https://www.theleidencollection.com/essays/the-signing-of-paintings-by-rembrandt-and-his-contemporaries/",
   "source_name": "The Leiden Collection"
  },
  {
   "text": "During 1632 he began adding 'van Rijn' to the monogram, and in 1632–33 he switched to signing with his first name alone in cursive script.",
   "source": "https://www.theleidencollection.com/essays/the-signing-of-paintings-by-rembrandt-and-his-contemporaries/",
   "source_name": "The Leiden Collection"
  },
  {
   "text": "The first-name signature was at first spelled ending in -nt ('Rembrant') and later -ndt ('Rembrandt'); he signed with his first name only until his death in 1669.",
   "source": "https://www.theleidencollection.com/essays/the-signing-of-paintings-by-rembrandt-and-his-contemporaries/",
   "source_name": "The Leiden Collection"
  },
  {
   "text": "About three quarters of Rembrandt's known paintings bear his name; a 2017 survey by Ernst van de Wetering counted 257 signed works among 349 paintings.",
   "source": "https://www.theleidencollection.com/essays/the-signing-of-paintings-by-rembrandt-and-his-contemporaries/",
   "source_name": "The Leiden Collection"
  }
 ],
