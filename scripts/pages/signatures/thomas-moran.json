{
 "artist": "Thomas Moran",
 "slug": "thomas-moran",
 "born": 1837,
 "died": 1926,
 "nationality": "American (born in England)",
 "facts": [
  {
   "text": "After his 1871 journey to Yellowstone, Moran began signing paintings with a 'TYM' monogram, for Thomas 'Yellowstone' Moran.",
   "source": "https://centerofthewest.org/2019/09/20/treasures-thomas-moran-zoroaster-peak/",
   "source_name": "Buffalo Bill Center of the West"
  },
  {
   "text": "The National Gallery of Art reads the monogram on Green River Cliffs (1881) as the letters T, Y (for Yellowstone) and M joined together, followed by 'ORAN'.",
   "source": "https://www.nga.gov/collection/art-object-page.82648.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "For further verification, Moran sometimes added his own thumbprint in paint; on Zoroaster Peak (1918) a slender thumbprint sits beside the TYM monogram at lower right.",
   "source": "https://centerofthewest.org/2019/09/20/treasures-thomas-moran-zoroaster-peak/",
   "source_name": "Buffalo Bill Center of the West"
  },
  {
   "text": "Before Yellowstone he signed in full: a London drawing of 1862 is signed 'Thomas Moran', and The Juniata, Evening (1864) reads 'THOS.MORAN.1864 / OP.8.', with an opus number.",
   "source": "https://www.nga.gov/collection/art-object-page.153202.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "On his etchings he used a plain 'TM' monogram in the plate and signed impressions 'T. Moran' in pencil.",
   "source": "https://www.nga.gov/collection/art-object-page.149144.html",
   "source_name": "National Gallery of Art"
  }
 ],
