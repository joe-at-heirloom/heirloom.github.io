 "nationality": "French",
 "facts": [
  {
   "text": "Cézanne rarely signed or dated his work, so curators date much of it from style and details such as dress and furnishings.",
   "source": "https://www.theartnewspaper.com/2017/06/11/long-neglected-portraits-by-cezanne-arrive-in-paris",
   "source_name": "The Art Newspaper (John Elderfield)"
  },
  {
   "text": "He signed his name without an accent: 'Cezanne'.",
   "source": "https://www.artic.edu/digital-publications/47/cezanne-paintings-and-watercolors-at-the-art-institute-of-chicago/364/note-to-the-reader-364",
   "source_name": "Art Institute of Chicago"
  },
  {
   "text": "Of the National Gallery of Art's Cézannes, only three paintings carry a signature, all from 1866–c. 1876; the 1873 House of Père Lacroix is signed and dated 'P. Cezanne 73.'",
   "source": "https://www.nga.gov/collection/art-object-page.46577.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "His sketchbook drawings at the National Gallery of Art are unsigned; the numbers on them were added by later hands.",
   "source": "https://www.nga.gov/collection/art-object-page.76223.html",
   "source_name": "National Gallery of Art"
  }
 ],
