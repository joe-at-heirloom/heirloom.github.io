{
 "artist": "Amedeo Modigliani",
 "slug": "amedeo-modigliani",
 "born": 1884,
 "died": 1920,
 "nationality": "Italian",
 "facts": [
  {
   "text": "An early portrait, Jean-Baptiste Alexandre with a Crucifix (1909), is signed and dated \"Modigliani 1909\" at the upper left in dark blue.",
   "source": "https://www.tate.org.uk/research/tate-papers/35/works-by-modigliani-that-have-paintings-beneath-the-visible-surface",
   "source_name": "Tate Papers"
  },
  {
   "text": "Not every painting was signed: Paul Alexandre in Front of a Window (1913) is neither signed nor dated.",
   "source": "https://www.tate.org.uk/research/tate-papers/35/works-by-modigliani-that-have-paintings-beneath-the-visible-surface",
   "source_name": "Tate Papers"
  },
  {
   "text": "On late portraits such as Portrait of a Girl (about 1917) the signature \"modigliani\" is at the top right in slightly thinned dark paint, without a date.",
   "source": "https://www.tate.org.uk/research/tate-papers/35/works-by-modigliani-that-have-paintings-beneath-the-visible-surface",
   "source_name": "Tate Papers"
  },
  {
   "text": "On Self-Portrait as Pierrot (1915) he painted the word PIERROT on the picture as well as his name, and the back is inscribed \"MODIGLIANI 1915\".",
   "source": "https://open.smk.dk/artwork/image/KMSr88",
   "source_name": "Statens Museum for Kunst"
  },
  {
   "text": "Most of the National Gallery of Art's 1917–1919 portraits are signed \"modigliani\" in lower case at the upper right; Madame Kisling is signed at the lower right.",
   "source": "https://www.nga.gov/collection/art-object-page.46650.html",
   "source_name": "National Gallery of Art"
  }
 ],
