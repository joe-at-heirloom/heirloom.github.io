{
 "artist": "Edgar Degas",
 "slug": "edgar-degas",
 "born": 1834,
 "died": 1917,
 "nationality": "French",
 "facts": [
  {
   "text": "An early drawing of his brother is inscribed and signed with his initial: 'à René / E Degas 1855.'",
   "source": "https://www.nga.gov/collection/art-object-page.93008.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "Around 1871 he still sometimes signed 'E. Degas' with the year; most later works are signed simply 'Degas'.",
   "source": "https://www.nga.gov/collection/art-object-page.91222.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "Works left in his studio at his death were stamped with a printed 'Degas' signature, usually red, catalogued by Lugt as no. 658 and described by the National Gallery of Art as the vente (sale) stamp.",
   "source": "https://www.nga.gov/collection/art-object-page.94902.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "A second studio stamp, an oval reading 'ATELIER ED. DEGAS' (Lugt 657), was also applied to works from the studio, often on the back.",
   "source": "https://www.nga.gov/collection/art-object-page.93010.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "The signature stamp was not always red: on the monotype The Green Room it is blue-grey.",
   "source": "https://www.nga.gov/collection/art-object-page.34702.html",
   "source_name": "National Gallery of Art"
  }
 ],
