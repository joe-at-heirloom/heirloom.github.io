{
 "artist": "Wassily Kandinsky",
 "slug": "wassily-kandinsky",
 "born": 1866,
 "died": 1944,
 "nationality": "Russian, later German and French",
 "facts": [
  {
   "text": "Kandinsky's early Munich paintings are signed 'KANDINSKY' in capital letters; on Schwabing, Winter Sun (1901) it is in red at lower right, with title, place and date written on the back.",
   "source": "https://www.centrepompidou.fr/en/ressources/oeuvre/cqG79Xp",
   "source_name": "Centre Pompidou"
  },
  {
   "text": "By the 1920s he signed paintings on the front with a monogram the Pompidou in Paris reads as 'VK' and a two-digit year, as on Auf Weiss II ('VK 23', lower left).",
   "source": "https://www.centrepompidou.fr/en/ressources/oeuvre/cKaan6A",
   "source_name": "Centre Pompidou"
  },
  {
   "text": "On the back of later paintings he added the monogram, a running number from his own handlist and the year, as on Ein Kreis (A): 'VK EIN KREIS a, N°420/1928'.",
   "source": "https://www.centrepompidou.fr/en/ressources/oeuvre/cajXrBg",
   "source_name": "Centre Pompidou"
  },
  {
   "text": "The 1922 Bauhaus portfolio Kleine Welten carries the 'VK 22' monogram in the printing surface and a pencil signature 'Kandinsky' on each sheet.",
   "source": "https://open.smk.dk/artwork/image/KKS13672/3",
   "source_name": "Statens Museum for Kunst"
  },
  {
   "text": "To Nina for Christmas (1926) is monogrammed 'VK 26' on the front and dedicated on the back in Russian to his wife Nina, dated Christmas Eve 1926, Dessau.",
   "source": "https://www.centrepompidou.fr/fr/ressources/oeuvre/czz9Gpy",
   "source_name": "Centre Pompidou"
  }
 ],
