{
 "artist": "Gustav Klimt",
 "slug": "gustav-klimt",
 "born": 1862,
 "died": 1918,
 "nationality": "Austrian",
 "facts": [
  {
   "text": "On the portrait of Gertrud Loew (1902) Klimt placed his signature and the date \"1902\" inside two green squares reminiscent of the signature stamps on Japanese woodcuts.",
   "source": "https://www.klimt-database.com/en/klimts-artworks/1901-1903/pear-tree",
   "source_name": "Klimt Foundation, Klimt Database"
  },
  {
   "text": "On the portrait of Emilie Flöge (1902/03) he inscribed two square signets with \"Gustav Klimt 1902\".",
   "source": "https://www.klimt-database.com/en/klimts-artworks/1901-1903/pear-tree",
   "source_name": "Klimt Foundation, Klimt Database"
  },
  {
   "text": "He added the signature and the date 1904 to the portrait of Hermine Gallia only after it had been exhibited, in what the Klimt Foundation calls his \"already familiar square signet\" at the upper right.",
   "source": "https://www.klimt-database.com/en/klimts-artworks/1901-1903/pear-tree",
   "source_name": "Klimt Foundation, Klimt Database"
  },
  {
   "text": "On drawings he often signed in capitals stacked on two lines, writing a Roman V for U: \"GVSTAV / KLIMT\".",
   "source": "https://www.nga.gov/collection/art-object-page.53826.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "Drawings that left his studio after his death in 1918 often carry the estate stamp \"GVSTAV / KLIMT / NACHLASS\" (Lugt 1575) rather than a signature.",
   "source": "https://www.nga.gov/collection/art-object-page.48302.html",
   "source_name": "National Gallery of Art"
  }
 ],
