{
 "artist": "Pierre-Auguste Renoir",
 "slug": "pierre-auguste-renoir",
 "born": 1841,
 "died": 1919,
 "nationality": "French",
 "facts": [
  {
   "text": "In the mid-1860s Renoir signed in capitals with his initial and the full year, as on Mademoiselle Sicot: 'A. RENOIR / 1865'.",
   "source": "https://www.nga.gov/collection/art-object-page.46684.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "Small oil studies of 1866 carry only the initials 'AR'.",
   "source": "https://www.nga.gov/collection/art-object-page.52210.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "By the mid-1870s he usually dropped the initial and signed 'Renoir.' with a two-digit year, as on A Girl with a Watering Can: 'Renoir. 76.'",
   "source": "https://www.nga.gov/collection/art-object-page.46681.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "Some works left unsigned carry a stamped 'Renoir' atelier signature instead, as on Peaches on a Plate (1902/1905).",
   "source": "https://www.nga.gov/collection/art-object-page.52223.html",
   "source_name": "National Gallery of Art"
  }
 ],
