{
 "artist": "Childe Hassam",
 "slug": "childe-hassam",
 "born": 1859,
 "died": 1935,
 "nationality": "American",
 "facts": [
  {
   "text": "Hassam's early signatures carry a crescent before the name; later he reduced it to a simple slash.",
   "source": "https://www.theartstory.org/artist/hassam-childe/",
   "source_name": "The Art Story"
  },
  {
   "text": "In his pen drawings of 1885–86 he stacked the signature in three lines: 'Childe / Hassam / 85'.",
   "source": "https://www.nga.gov/collection/art-object-page.60976.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "From 1918 his lithographs are signed and dated on the stone, often with the day and place, and each impression is also marked in pencil with his monogram.",
   "source": "https://www.nga.gov/collection/art-object-page.182675.html",
   "source_name": "National Gallery of Art"
  },
  {
   "text": "His late etchings carry the monogram in the plate; the pencil monogram is followed by 'imp' to show he printed the impression himself.",
   "source": "https://www.nga.gov/collection/art-object-page.170294.html",
   "source_name": "National Gallery of Art"
  }
 ],
